#!/bin/bash
set -euo pipefail

# The ONCE post-restore hook: restores the database the way the Rails image's hooks/post-restore
# did, using the app's path precedence.
storage="${CAMPFIRE_STORAGE_PATH:-${CAMPFIRE_STORAGE:-/rails/storage}}"
db_name="${RAILS_ENV:-production}.sqlite3"
db="${CAMPFIRE_DATABASE_PATH:-$storage/db/$db_name}"
backups="${CAMPFIRE_BACKUPS_PATH:-$storage/backups}"
snapshot="$backups/$(basename "$db")"

if [ -f "$snapshot" ]; then
  mkdir -p "$(dirname "$db")"
  cp "$snapshot" "$db"
  rm -f "$db-wal" "$db-shm"
fi

# Boot refuses a database whose migrations differ from this build's, so a backup
# taken before a later release is brought up to this image here, exactly as a
# release does: one transaction, nothing written on failure. db-migrate refuses a
# database that already has migrations this image doesn't know (a backup from a
# newer release); restore that onto an image at least as new instead.
if [ -f "$db" ]; then
  if ! campfire db-migrate "$db"; then
    echo "post-restore: campfire db-migrate refused the restored database; it was left as restored and this image will not boot on it" >&2
    exit 1
  fi
fi
# Redis removal is an explicit cutover step, never a Rust restore side effect.
