# The Rust app image (Dockerfile) builds from Cargo.toml, Cargo.lock and crates/ in this context,
# including retained inputs in crates/static_assets, plus classic web/ bundles and frontend/ sources (the SPA that
# crates/spa embeds, built in the image), the ops/ hooks it installs and, for the CI toolchain
# stage, rust-toolchain.toml. Everything else stays out.
# deploy/huddles/Dockerfile has its own Dockerfile.dockerignore.

/.git
/.github
/.gitignore
/.gitattributes
# Cargo config: Cranelift for dev/test builds. The production build stays on LLVM.
/.cargo
/.cargo-home
/.claude
/target
/.scratch
/storage
/log
/tmp
/Dockerfile
/.dockerignore

# Credentials and scratch files a CI job or a developer can leave at the root, which is the build
# context: google-github-actions/auth writes gha-creds-*.json into the workspace before
# publish-image.yml builds, and its tag check writes err.log. None may reach the builder.
/gha-creds-*.json
/.env
/.env.*
/*.log
/.netrc
/.npmrc
/.docker
/.config
**/node_modules

# Documentation, deployment scripts and agent notes: none is built into an image.
/*.md
/MIT-LICENSE
/docs
/deploy

# Test, benchmark and parity inputs.
/bench
/parity
/plans
/vectors
/reference-tools
/fixtures
/test-support
/ops/tests
/ops/README.md
/web/bin
/web/script
/web/.bundle
# The huddle gateway has its own image (deploy/huddles/Dockerfile).
/huddle-gateway
/crates/static_assets/public/assets
# frontend/: the sources the image's spa stage builds from, never a local build or test output
# (node_modules is excluded above).
/frontend/dist
/frontend/.vite
/frontend/test-results
/frontend/playwright-report
/frontend/*.tsbuildinfo

# crates: test data isn't compiled into the binary
/crates/*/target
/crates/*/tests/golden
