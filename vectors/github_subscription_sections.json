value=\"merged\" checked=\"checked\" />\n              Merged\n            </label>\n            <label class=\"flex align-center gap txt-small\">\n              <input type=\"checkbox\" name=\"github_repository_subscription[events][]\" id=\"github_subscription_new_closed\" value=\"closed\" />\n              Closed\n            </label>\n            <label class=\"flex align-center gap txt-small\">\n              <input type=\"checkbox\" name=\"github_repository_subscription[events][]\" id=\"github_subscription_new_review_requested\" value=\"review_requested\" checked=\"checked\" />\n              Review requested\n            </label>\n            <label class=\"flex align-center gap txt-small\">\n              <input type=\"checkbox\" name=\"github_repository_subscription[events][]\" id=\"github_subscription_new_review_submitted\" value=\"review_submitted\" />\n              Review submitted\n            </label>\n            <label class=\"flex align-center gap txt-small\">\n              <input type=\"checkbox\" name=\"github_repository_subscription[events][]\" id=\"github_subscription_new_checks_failed\" value=\"checks_failed\" checked=\"checked\" />\n              Checks failed\n            </label>\n        </div>\n\n          <label class=\"flex align-center gap txt-small\">\n            <input type=\"checkbox\" name=\"github_repository_subscription[skip_access_check]\" id=\"github_subscription_new_skip_access_check\" value=\"1\" />\n            Subscribe without verifying my GitHub access (private pull-request titles stay hidden)\n          </label>\n\n        <div>\n          <input type=\"submit\" name=\"commit\" value=\"Subscribe\" class=\"btn btn--reversed\" data-disable-with=\"Subscribe\" />\n        </div>\n</form>    </div>\n  </section>\n"
