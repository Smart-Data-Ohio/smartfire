      "html": "\n\n<section class=\"panel panel--wide txt-align-center flex flex-column position-relative\" style=\"view-transition-name: workspace-icons\">\n  <div class=\"flex align-center gap\">\n    <div class=\"pad-inline-double center\">\n      <h1 class=\"margin-none\">Workspace icons</h1>\n      <p class=\"margin-none-block-start\">Upload SVG or PNG icons members can use as <code>:shortcodes:</code> in messages and reactions.</p>\n    </div>\n  </div>\n\n  <div class=\"pad-inline pad-block-start\">\n    <form class=\"flex flex-column gap txt-align-start fill-shade border-radius pad\" enctype=\"multipart/form-data\" action=\"/account/icons\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"authenticity_token\" value=\"post:/account/icons\" />\n\n      <div class=\"flex align-center gap\">\n        <label class=\"flex flex-column gap flex-item-grow\">\n          <span class=\"txt-small\"><strong>Name</strong> <span class=\"txt-subtle\">lowercase letters, numbers, underscores, 2–32 characters</span></span>\n          <input class=\"input\" autocomplete=\"off\" placeholder=\"acme\" type=\"text\" value=\"&lt;b&gt;name &amp; &quot;&lt;/b&gt;\" name=\"workspace_icon[name]\" id=\"workspace_icon_name\" />\n        </label>\n\n        <label class=\"flex flex-column gap flex-item-grow\">\n          <span class=\"txt-small\"><strong>Title</strong></span>\n          <input class=\"input\" autocomplete=\"off\" placeholder=\"Acme Corp\" type=\"text\" value=\"&lt;i&gt;Form title &amp; &quot;&lt;/i&gt;\" name=\"workspace_icon[title]\" id=\"workspace_icon_title\" />\n        </label>\n      </div>\n\n      <label class=\"flex flex-column gap\">\n        <span class=\"txt-small\"><strong>Icon file</strong> <span class=\"txt-subtle\">SVG or square PNG (at least 64px), at most 256 KB</span></span>\n        <input class=\"input\" accept=\"image/svg+xml,image/png\" type=\"file\" name=\"workspace_icon[image]\" id=\"workspace_icon_image\" />\n      </label>\n\n      <div>\n        <input type=\"submit\" name=\"commit\" value=\"Upload icon\" class=\"btn btn--reversed\" data-disable-with=\"Upload icon\" />\n      </div>\n</form>  </div>\n\n  <div class=\"pad-inline pad-block-start\">\n    <menu class=\"flex flex-column gap margin-none pad\">\n        <li class=\"flex flex-column gap flush fill-shade border-radius pad-block pad-inline-double\">\n  <div class=\"flex align-center gap\">\n    <span class=\"autocomplete__icon\" style=\"font-size: 2em;\">\n      <img alt=\"\" loading=\"lazy\" src=\"/icons/acme\" width=\"32\" height=\"32\" />\n    </span>\n\n    <div class=\"min-width txt-align-start\">\n      <div class=\"overflow-ellipsis txt-large\"><strong>&lt;b&gt;Icon &amp; &quot;&lt;/b&gt;</strong> <code>:acme:</code></div>\n      <div class=\"overflow-ellipsis txt-small\">\n        Uploaded by &lt;b&gt;Creator &amp; &quot;&lt;/b&gt;\n      </div>\n    </div>\n\n    <form data-turbo-confirm=\"Delete :acme:? Messages using it will show the literal shortcode.\" class=\"button_to\" method=\"post\" action=\"/account/icons/11001\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button class=\"btn btn--negative flex-item-justify-end\" type=\"submit\">\n      <img aria-hidden=\"true\" src=\"/assets/trash-708c7eb2.svg\" width=\"20\" height=\"20\" />\n      <span class=\"for-screen-reader\">Delete :acme:</span>\n</button><input type=\"hidden\" name=\"authenticity_token\" value=\"delete:/account/icons/11001\" /></form>  </div>\n</li>\n<li class=\"flex flex-column gap flush fill-shade border-radius pad-block pad-inline-double\">\n  <div class=\"flex align-center gap\">\n    <span class=\"autocomplete__icon\" style=\"font-size: 2em;\">\n      <img alt=\"\" loading=\"lazy\" src=\"/icons/zeta\" width=\"32\" height=\"32\" />\n    </span>\n\n    <div class=\"min-width txt-align-start\">\n      <div class=\"overflow-ellipsis txt-large\"><strong>&lt;script&gt;title()&lt;/script&gt;</strong> <code>:zeta:</code></div>\n      <div class=\"overflow-ellipsis txt-small\">\n        Uploaded by &lt;b&gt;Creator &amp; &quot;&lt;/b&gt;\n      </div>\n    </div>\n\n    <form data-turbo-confirm=\"Delete :zeta:? Messages using it will show the literal shortcode.\" class=\"button_to\" method=\"post\" action=\"/account/icons/11002\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button class=\"btn btn--negative flex-item-justify-end\" type=\"submit\">\n      <img aria-hidden=\"true\" src=\"/assets/trash-708c7eb2.svg\" width=\"20\" height=\"20\" />\n      <span class=\"for-screen-reader\">Delete :zeta:</span>\n</button><input type=\"hidden\" name=\"authenticity_token\" value=\"delete:/account/icons/11002\" /></form>  </div>\n</li>\n\n    </menu>\n  </div>\n</section>\n",
      "nav": "  <div class=\"flex-item-justify-start\">\n    <a class=\"btn\" href=\"/account/edit\"><img aria-hidden=\"true\" src=\"/assets/arrow-left-abe40556.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Go Back</span></a>\n  </div>\n"
    }
