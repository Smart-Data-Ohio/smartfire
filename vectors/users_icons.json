    {
      "name": "empty",
      "html": "\n\n<section class=\"panel panel--wide txt-align-center flex flex-column position-relative\" style=\"view-transition-name: workspace-icons\">\n  <div class=\"flex align-center gap\">\n    <div class=\"pad-inline-double center\">\n      <h1 class=\"margin-none\">Workspace icons</h1>\n      <p class=\"margin-none-block-start\">Upload SVG or PNG icons members can use as <code>:shortcodes:</code> in messages and reactions.</p>\n    </div>\n  </div>\n\n  <div class=\"pad-inline pad-block-start\">\n    <form class=\"flex flex-column gap txt-align-start fill-shade border-radius pad\" enctype=\"multipart/form-data\" action=\"/account/icons\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"authenticity_token\" value=\"post:/account/icons\" />\n\n      <div class=\"flex align-center gap\">\n        <label class=\"flex flex-column gap flex-item-grow\">\n          <span class=\"txt-small\"><strong>Name</strong> <span class=\"txt-subtle\">lowercase letters, numbers, underscores, 2–32 characters</span></span>\n          <input class=\"input\" autocomplete=\"off\" placeholder=\"acme\" type=\"text\" name=\"workspace_icon[name]\" id=\"workspace_icon_name\" />\n        </label>\n\n        <label class=\"flex flex-column gap flex-item-grow\">\n          <span class=\"txt-small\"><strong>Title</strong></span>\n          <input class=\"input\" autocomplete=\"off\" placeholder=\"Acme Corp\" type=\"text\" name=\"workspace_icon[title]\" id=\"workspace_icon_title\" />\n        </label>\n      </div>\n\n      <label class=\"flex flex-column gap\">\n        <span class=\"txt-small\"><strong>Icon file</strong> <span class=\"txt-subtle\">SVG or square PNG (at least 64px), at most 256 KB</span></span>\n        <input class=\"input\" accept=\"image/svg+xml,image/png\" type=\"file\" name=\"workspace_icon[image]\" id=\"workspace_icon_image\" />\n      </label>\n\n      <div>\n        <input type=\"submit\" name=\"commit\" value=\"Upload icon\" class=\"btn btn--reversed\" data-disable-with=\"Upload icon\" />\n      </div>\n</form>  </div>\n\n  <div class=\"pad-inline pad-block-start\">\n    <menu class=\"flex flex-column gap margin-none pad\">\n        <li class=\"txt-subtle\">No workspace icons yet.</li>\n    </menu>\n  </div>\n</section>\n",
