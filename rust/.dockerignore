# The Rust app image (Dockerfile) builds from Cargo.toml, Cargo.lock and crates/ in this context,
# plus the parts of web/ that crates/assets/build.rs embeds. Everything else stays out.

/.git
/.gitignore
# Cargo config: Cranelift for dev/test builds. The production build stays on LLVM.
/.cargo
/.claude
/target
/parity
/plans
/vectors
/reference-tools
/NOTES.md
/AGENTS.md
/CLAUDE.md
/ops/tests
/fixtures
/test-support
/web/bin
/web/script
/web/.bundle
/web/public/assets
/ops/README.md
/.scratch
/Dockerfile
/.dockerignore

# crates: test data isn't compiled into the binary
/crates/*/target
/crates/*/tests/golden
