\"hidden\" name=\"start_huddle\" value=\"\" data-multi-select-target=\"huddleInput\">\n\n    <button type=\"submit\" class=\"btn btn--reversed\" data-multi-select-target=\"messageButton\">Message (0)</button>\n    <button type=\"submit\" class=\"btn\" data-action=\"click->multi-select#submitHuddle\"\n        data-multi-select-target=\"huddleButton\">Start huddle (0)</button>\n      <button type=\"button\" class=\"btn\" data-action=\"click->multi-select#clear\">Clear</button>\n</form>\n  <p class=\"multi-select-bar__note\" role=\"status\" data-multi-select-target=\"note\" hidden></p>\n</div>\n<span class=\"for-screen-reader\" role=\"status\" data-multi-select-target=\"status\">0 selected</span>\n\n  </div>\n</turbo-frame>\n"
