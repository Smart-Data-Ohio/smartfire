      "html": "<form action=\"/rooms/opens\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"authenticity_token\" value=\"post:/rooms/opens\" />\n\n  <div class=\"flex align-center gap\">\n      <details class=\"position-relative\" data-controller=\"popup\" data-action=\"keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside\" data-popup-orientation-top-class=\"popup-orientation-top\"><summary class=\"btn\" tabindex=\"-1\"><img aria-hidden=\"true\" class=\"color-icon\" src=\"/assets/globe-8c54d23b.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Translate</span></summary><div class=\"language-list-menu shadow\" data-popup-target=\"menu\"><dl class=\"language-list\"><dt>🇺🇸</dt><dd class=\"margin-none\">Name the room</dd><dt>🇪🇸</dt><dd class=\"margin-none\">Nombrar la sala</dd><dt>🇫🇷</dt><dd class=\"margin-none\">Nommez la salle</dd><dt>🇮🇳</dt><dd class=\"margin-none\">कमरे का नाम दें</dd><dt>🇩🇪</dt><dd class=\"margin-none\">Geben Sie dem Raum einen Namen</dd><dt>🇧🇷</dt><dd class=\"margin-none\">Dê um nome a essa sala</dd><dt>🇯🇵</dt><dd class=\"margin-none\">ルームに名前を付ける</dd></dl></div></details>\n\n      <label class=\"flex-item-grow txt-large\">\n        <input name=\"room[name]\" id=\"room_name\" class=\"input full-width\" required=\"required\" autofocus=\"autofocus\" placeholder=\"Name the room\" data-turbo-permanent=\"true\" data-action=\"keydown.enter-&gt;form#submit:prevent\" type=\"text\" value=\"Form &lt;&amp;&gt;\" />\n        <span class=\"for-screen-reader\">Name this room</span>\n      </label>\n  </div>\n\n    <div class=\"margin-block-start\">\n      <div data-controller=\"icon-field\" data-icon-field-url-value=\"/autocompletable/icons\">\n  <label class=\"txt-small\" for=\"room_icon_name\">Icon</label>\n\n  <div class=\"flex align-center gap\">\n    <span class=\"icon-field__preview flex-item-no-shrink\" data-icon-field-target=\"preview\"></span>\n\n    <input name=\"room[icon_name]\" id=\"room_icon_name\" class=\"input flex-item-grow\" placeholder=\":shortcode:\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\" data-icon-field-target=\"input\" data-action=\"input-&gt;icon-field#preview input-&gt;markdown-autocomplete#search focus-&gt;markdown-autocomplete#focus blur-&gt;markdown-autocomplete#blur\" data-controller=\"markdown-autocomplete\" data-markdown-autocomplete-icons-url-value=\"/autocompletable/icons\" type=\"text\" />\n\n    <button type=\"button\" class=\"btn flex-item-no-shrink\" data-action=\"icon-field#clear\">Remove</button>\n  </div>\n\n  <p class=\"txt-small\">Type : to search the icon set. Leave blank for the default.</p>\n</div>\n\n    </div>\n\n  <hr class=\"margin-block borderless\">\n\n  <section class=\"room-access margin-block pad-inline fill-shade border-radius\">\n    <p>Access fixture</p>\n  </section>\n\n  <button name=\"button\" type=\"submit\" class=\"btn btn--reversed txt-large center\"><img aria-hidden=\"true\" src=\"/assets/check-7897ff7e.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Save</span></button>\n</form>"
