    {
      "file": "test/models/calendar/meeting_intervals_test.rb",
      "source_sha256": "eb10388b3794c7909b966d34c25ab89b3ea13b455a646f333ffa42536f2c1dd8",
      "test": "a declined event from another attendee still counts",
      "assertions": 1,
      "calls": [
        {
          "kind": "meeting",
          "items": [
            {
              "status": "confirmed",
              "start": {
                "dateTime": "2026-09-23T10:00:00Z",
                "timeZone": "UTC"
              },
              "end": {
                "dateTime": "2026-09-23T11:00:00Z",
                "timeZone": "UTC"
              },
              "attendees": [
                {
                  "email": "jason@gmail.test",
                  "responseStatus": "declined"
                },
                {
                  "self": true,
                  "responseStatus": "accepted"
                }
              ]
            }
          ],
          "zone": "UTC",
          "result": [
            [
              "2026-09-23T10:00:00Z",
              "2026-09-23T11:00:00Z"
            ]
          ]
        }
      ]
    },
