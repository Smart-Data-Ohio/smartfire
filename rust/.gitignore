target/
/parity/node_modules
/parity/.seed
/parity/.ci
/.claude
/.cargo-home
__pycache__/
# Local LiveKit and the bundle builders write into web/.
/web/public/assets
/web/script/*/node_modules/
/web/.bundle
# Local server output: `cargo run -p campfire -- server` keeps its database, uploads and backups in
# storage/ under the working directory unless CAMPFIRE_STORAGE_PATH says otherwise.
/storage/
/log/
/tmp/
*.sqlite3
*.sqlite3-*
# The committed test seeds are SQLite databases too.
!/parity/seeds/frozen/*/db/*.sqlite3
