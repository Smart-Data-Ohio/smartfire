#!/usr/bin/env bash
# CI parity inputs: archive the pin, restore/build an image, and always validate seeds.
# Usage: parity/bin/ci-seed prepare|image|build|validate
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
WORK=$ROOT/parity/.ci
PIN=$(cat "$ROOT/parity/reference.sha")
[[ $PIN =~ ^[0-9a-f]{40}$ ]] || { echo 'ci-seed: invalid reference.sha' >&2; exit 1; }
export CAMPFIRE_REFERENCE=$WORK/reference
export PARITY_REFERENCE_REVISION=$PIN PARITY_NAMESPACE=ws19b-ci PARITY_OWNER=ws19b-ci
export PARITY_RUNTIME=docker PARITY_IMAGE=${PARITY_IMAGE:-ws19b-ci-reference}
export PARITY_REFERENCE_APP_IMAGE=ws19b-ci-reference:app
SEEDS=${PARITY_SEED_DIR:-$ROOT/parity/.seed}
mkdir -p "$WORK"

check_image() {
  local revision
  revision=$(docker image inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$PARITY_IMAGE" | sed -n 's/^GIT_REVISION=//p')
  [ "$revision" = "$PIN" ] || { echo 'ci-seed: reference image has the wrong Rails revision' >&2; exit 1; }
}

case "${1:-}" in
  prepare)
    # Checkout is shallow. The public reference needs no credentials or PR secrets.
    git -C "$ROOT/.." cat-file -e "$PIN^{commit}" 2>/dev/null ||
      git -C "$ROOT/.." fetch --no-tags --depth=1 origin "$PIN"
    rm -rf "$CAMPFIRE_REFERENCE"
    mkdir -p "$CAMPFIRE_REFERENCE"
    git -C "$ROOT/.." archive "$PIN" | tar -x -C "$CAMPFIRE_REFERENCE"
    python3 "$ROOT/parity/ci_seed.py"
    ;;
  image)
    if [ -f "$WORK/image/reference.tar" ]; then
      docker load --input "$WORK/image/reference.tar"
      echo 'ci-seed: reference image restored'
    else
      "$ROOT/parity/bin/reference" build
      mkdir -p "$WORK/image"
      docker save --output "$WORK/image/reference.tar" "$PARITY_IMAGE"
      echo 'ci-seed: reference image built'
    fi
    check_image
    ;;
  check-image) check_image ;;
  build)
    "$ROOT/parity/bin/seed" build default first_run
    ;;
  validate)
    for seed in default first_run; do
      test -s "$SEEDS/$seed/db/production.sqlite3"
      test -f "$SEEDS/$seed/labels.json"
      test -d "$SEEDS/$seed/storage"
      "$ROOT/parity/bin/reference" runner --seed "$seed" --time 2026-03-02T16:00:00Z --freeze \
        "$ROOT/reference-tools/campfire/verify_parity_seed.rb" "$seed"
      echo "ci-seed: $seed validated"
    done
    ;;
  *) echo 'usage: parity/bin/ci-seed prepare|image|build|validate' >&2; exit 1 ;;
esac
