#!/usr/bin/env bash
# Concurrent boots into a fresh namespace must both succeed, with an internal bridge.
set -euo pipefail
PARITY=$(cd "$(dirname "$0")/.." && pwd)
base_namespace=${PARITY_NAMESPACE:-campfire}
export PARITY_IMAGE=${PARITY_IMAGE:-$base_namespace-reference}
export PARITY_NAMESPACE=$base_namespace-network-race-$$
export PARITY_NETWORK=$PARITY_NAMESPACE-parity-internal
out=$PARITY/out/$PARITY_NAMESPACE
mkdir -p "$out"
cleanup() {
  for port in 49751 49752; do "$PARITY/bin/reference" down --port "$port" >/dev/null 2>&1 || true; done
  docker network rm "$PARITY_NETWORK" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
for round in 1 2 3; do
  "$PARITY/bin/reference" up --seed default --port 49751 --time 2026-03-02T16:00:00Z --freeze >"$out/$round-a.log" 2>&1 & a=$!
  "$PARITY/bin/reference" up --seed default --port 49752 --time 2026-03-02T16:00:00Z --freeze >"$out/$round-b.log" 2>&1 & b=$!
  wait "$a"; wait "$b"
  internal=$(docker network inspect -f '{{.Internal}}' "$PARITY_NETWORK")
  [ "$internal" = true ]
  echo "round $round: both reference boots exit 0; Internal=$internal"
  cleanup
done
