#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
cd "$root/rust"
command -v node >/dev/null
command -v chromedriver >/dev/null
command -v unshare >/dev/null
docker info >/dev/null
python3 reference-tools/users/check_ws14_original_browser.py
export CI=1
export WS14_BROWSER_SCRATCH="${WS14_BROWSER_SCRATCH:-${XDG_CACHE_HOME:-$HOME/.cache}/rust-port/ws14-browser}"
cargo nextest run --locked -p campfire -j 4 \
  -E 'test(controllers::ws14_original_browser_tests::) | test(controllers::ws15_original_github_browser_tests::)' --run-ignored only \
  --no-tests fail --no-fail-fast --success-output immediate --failure-output immediate
