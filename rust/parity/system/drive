#!/usr/bin/env bash
# Rust-only browser ports of the pinned Drive and sudo system tests (drive_browser_tests.rs).
# Pass a test-name filter to run a subset, e.g. parity/system/drive drive_browser_ws14g_232.
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$root/.."
hash=$(cat rust/parity/Dockerfile.playwright rust/parity/package-lock.json | sha256sum | cut -c1-12)
image="ws13-parity-playwright:$hash"
if ! docker image inspect "$image" >/dev/null 2>&1; then
  docker build -q --label parity.owner=ws13 -f rust/parity/Dockerfile.playwright -t "$image" rust/parity
fi
python3 rust/parity/bin/frozen-seeds restore >/dev/null
WS13_PLAYWRIGHT_IMAGE="$image" CI=1 DRIVE_BROWSER_SCRATCH="${DRIVE_BROWSER_SCRATCH:-${XDG_CACHE_HOME:-$HOME/.cache}/rust-port/drive-browser}" \
  cargo test --locked --manifest-path rust/Cargo.toml -j 4 -p campfire --bin campfire \
  "${1:-controllers::drive_browser_tests::}" -- --ignored --test-threads="${DRIVE_BROWSER_THREADS:-2}"
