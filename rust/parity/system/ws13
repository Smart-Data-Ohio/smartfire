#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$root/.."
hash=$(cat rust/parity/Dockerfile.playwright rust/parity/package-lock.json | sha256sum | cut -c1-12)
image="ws13-parity-playwright:$hash"
if ! docker image inspect "$image" >/dev/null 2>&1; then
  docker build -q --label parity.owner=ws13 -f rust/parity/Dockerfile.playwright -t "$image" rust/parity
fi
WS13_PLAYWRIGHT_IMAGE="$image" CI=1 TMPDIR="$PWD/.scratch" CABLE_TEST_PORT_RANGE=52300-52349 MAIL_TEST_PORT_RANGE=52350-52399 CARGO_BUILD_JOBS=2 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 CARGO_INCREMENTAL=0 cargo test --locked --manifest-path rust/Cargo.toml -p campfire huddle_system_cases_in_real_browser -- --ignored --nocapture --test-threads=8
