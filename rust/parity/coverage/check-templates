#!/usr/bin/env ruby
# Template coverage: screenshot states plus separately recorded behavioral receipts.
#
#   parity/coverage/check-templates           fail if a template under reference/app/views has no
#                                             covering state/behavioral receipt/disposition, if a state
#                                             covers a template that doesn't exist, or if
#                                             templates.txt is stale
#   parity/coverage/check-templates --write   regenerate templates.txt
#
# Template names drop the handler extension and an .html format: rooms/show.html.erb is
# "rooms/show", messages/_message.json.jbuilder is "messages/_message.json". That's the form
# `covers:` uses in parity/screens.yml.
require "yaml"
require "json"

ROOT = File.expand_path("../..", __dir__)
# The reference Rails app: CAMPFIRE_REFERENCE, else the repository root that contains rust/.
REFERENCE_ROOT = File.expand_path(ENV.fetch("CAMPFIRE_REFERENCE", File.join(ROOT, "..")))
VIEWS = File.join(REFERENCE_ROOT, "app/views")
OUT = File.join(__dir__, "templates.txt")

def template_name(path)
  path.delete_prefix("#{VIEWS}/").sub(/\.(erb|jbuilder)\z/, "").sub(/\.html\z/, "")
end

templates = Dir[File.join(VIEWS, "**/*")].select { |f| File.file?(f) }.map { |f| template_name(f) }.sort
exclusions = YAML.load_file(File.join(__dir__, "exclusions.yml"))
inventory = YAML.load_file(File.join(ROOT, "parity/screens.yml"))
states = inventory.is_a?(Array) ? inventory : inventory.fetch("states")

covering = Hash.new { |h, k| h[k] = [] }
unknown = []
states.each do |state|
  Array(state["covers"]).each do |template|
    templates.include?(template) ? covering[template] << state["id"] : unknown << "#{state["id"]}: #{template}"
  end
end

behavioral = JSON.parse(File.read(File.join(ROOT, "parity/template-coverage.json"))).fetch("rails_templates")
receipts = behavioral.to_h do |name, entry|
  logical = name.sub(/\.(erb|jbuilder)\z/, "").sub(/\.html\z/, "")
  [logical, entry]
end
lines = [ "# template -> screen state ids or behavioral receipts (generated by parity/coverage/check-templates --write)",
          "# Behavioral entries are byte assertions, not screenshot or external-browser acceptance." ]
templates.each do |template|
  lines << if covering[template].any?
    "#{template} -> #{covering[template].uniq.join(" ")}"
  elsif receipts.dig(template, "status") == "covered"
    "#{template} -> BEHAVIORAL: #{receipts.fetch(template).fetch("evidence").join(" ")}"
  elsif receipts.dig(template, "status") == "not_reachable"
    "#{template} -> NOT_REACHABLE: #{receipts.fetch(template).fetch("branch")}"
  elsif exclusions.key?(template)
    "#{template} -> EXCLUDED: #{exclusions[template]}"
  else
    "#{template} -> UNCOVERED"
  end
end
report = lines.join("\n") + "\n"

if ARGV.include?("--write")
  File.write(OUT, report)
  puts "wrote #{OUT.delete_prefix("#{ROOT}/")}"
end

problems = []
problems += templates.reject { |t| covering[t].any? || %w[covered not_reachable].include?(receipts.dig(t, "status")) || exclusions.key?(t) }.map { |t| "uncovered template: #{t}" }
problems += unknown.map { |u| "covers a template that doesn't exist: #{u}" }
problems += (exclusions.keys - templates).map { |t| "exclusion for a template that doesn't exist: #{t}" }
problems += (exclusions.keys & covering.keys.select { |k| covering[k].any? }).map { |t| "excluded but covered: #{t}" }
problems << "templates.txt is stale: run parity/coverage/check-templates --write" if !ARGV.include?("--write") && (!File.exist?(OUT) || File.read(OUT) != report)

if problems.any?
  puts problems
  exit 1
else
  puts "#{templates.size} templates: #{templates.count { |t| covering[t].any? }} screen states, #{templates.count { |t| !covering[t].any? && receipts.dig(t, "status") == "covered" }} behavioral receipts, #{templates.count { |t| receipts.dig(t, "status") == "not_reachable" }} not reachable, #{exclusions.size} excluded"
end
