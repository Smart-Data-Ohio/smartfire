<% if @room.board? %>
  <%= render "rooms/boards/index" %>
<% else %>
<% @page_title = room_display_name(@room) %>
<% @body_class = "sidebar room-workspace" %>
<% content_for :head do %>
  <%= turbo_exempts_page_from_preview %>
  <meta name="current-room-id" content="<%= @room.id %>">
  <%= first_paint_controller_preloads %>
<% end %>

<%= render "rooms/show/nav", room: @room %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>
<% content_for :member_panel do %>
  <%= render "rooms/show/member_panel", room: @room %>
<% end %>
<% content_for :thread_panel do %>
  <%= render "rooms/show/thread_panel", room: @room %>
<% end %>

<%# Mount point for the join-notice banner ("Chris is in your huddle").
    Always rendered empty: the per-viewer banner is injected client-side,
    so no personal state ever sits in a shared fragment. %>
<div id="huddle-join-banner-slot"></div>

<%= message_area_tag(@room, scroll_to_divider: @scroll_to_unread_divider) do %>
  <%= render "messages/template" %>

  <%= messages_tag(@room) do %>
    <%= render "rooms/show/invitation", room: @room %>
    <% if @unread_divider_message_id && (divider_index = @messages.index { |message| message.id == @unread_divider_message_id }) %>
      <%= render partial: "messages/message", collection: @messages.first(divider_index), locals: { thread_reply_counts: @thread_reply_counts } %>
      <%= render "messages/unread_divider", unread_count: @unread_count %>
      <%= render partial: "messages/message", collection: @messages[divider_index..], locals: { thread_reply_counts: @thread_reply_counts } %>
    <% else %>
      <%= render partial: "messages/message", collection: @messages, locals: { thread_reply_counts: @thread_reply_counts } %>
    <% end %>
  <% end %>

  <%= turbo_stream_from @room, :messages, channel: "RoomMessagesChannel" %>
  <%= button_to_jump_to_unread(url: @jump_to_unread_url) if @unread_divider_message_id || @jump_to_unread_url %>
  <%= button_to_jump_to_newest_message %>
<% end %>

<%= render "rooms/show/ooo_notices", room: @room, ooo_members: @ooo_notice_members || [] %>
<%= render "rooms/show/composer", room: @room %>
<%= render "polls/builder", room: @room %>
<% end %>
