<turbo-frame id="direct_rooms_control" target="_top">
  <div class="directs directs--new flex flex-column gap" data-controller="dm-picker multi-select">
    <div class="dm-picker__topbar flex gap flex-item-grow">
      <%= link_to user_sidebar_path, class: "btn flex-item-no-shrink", data: { turbo_frame: "user_sidebar", dm_picker_target: "cancel" } do %>
        <%= image_tag "arrow-left.svg", aria: { hidden: "true" } %>
        <span class="for-screen-reader">Back to sidebar</span>
      <% end %>

      <div class="input input--actor flex-item-grow min-width">
        <label class="for-screen-reader" for="dm_picker_filter">Filter people by name</label>
        <input type="search" id="dm_picker_filter" class="input" placeholder="Type names to filter…"
            autocomplete="off" autocorrect="off" spellcheck="false" data-1p-ignore="true"
            data-dm-picker-target="input"
            data-action="input->dm-picker#filter keydown.enter->dm-picker#selectSingle keydown.esc->dm-picker#cancel">
      </div>
    </div>

    <span class="txt-small translucent pad-inline-half center">Check people, then Message or Start huddle below. Enter selects the match when only one person matches.</span>

    <h2 class="txt-small translucent pad-inline-half center">Choose people</h2>

    <ul class="dm-picker__list">
      <% @users.each do |user| %>
        <li class="dm-picker__row multi-select-row" data-dm-picker-target="row" data-name="<%= user.name %>"
            data-action="click->dm-picker#toggleRow touchstart->multi-select#pressStart touchmove->multi-select#pressMove touchend->multi-select#pressEnd contextmenu->multi-select#suppressMenu">
          <input type="checkbox" id="pick_user_<%= user.id %>" data-multi-select-target="checkbox" data-action="click->multi-select#toggle"
              data-user-id="<%= user.id %>" data-bot="<%= user.bot? %>" aria-label="Select <%= user.name %>">
          <%= avatar_tag user, size: 32 %>
          <%= button_tag type: "button", class: "profile-card-name overflow-ellipsis", data: profile_card_trigger(user) do %>
            <strong><%= user.name %></strong>
          <% end %>
          <% if @starred_ids.include?(user.id) %>
            <span class="profile-card__badge" role="img" aria-label="Starred by you" title="Starred by you">★</span>
          <% end %>
          <% if user.agent %>
            <span class="profile-card__badge">Agent</span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <p class="dm-picker__empty txt-small translucent center" data-dm-picker-target="empty" role="status" hidden>No one matches that search.</p>

    <%= render "shared/multi_select_bar" %>
  </div>
</turbo-frame>
