<aside id="channel-members"
       class="member-panel"
       aria-label="Channel members"
       aria-hidden="true"
       inert
       data-member-panel-target="panel"
       data-members-url="<%= room_members_path(room, format: :json) %>"
       data-default-avatar-url="<%= asset_path("default-avatar.svg") %>"
       data-card-url-template="<%= profile_card_url_template %>"
       data-star-url-template="<%= user_star_path("USER_ID") %>">
  <button type="button"
          class="member-panel__backdrop"
          aria-hidden="true"
          tabindex="-1"
          data-member-panel-target="backdrop"
          data-action="member-panel#close"
          hidden></button>

  <section class="member-panel__surface" aria-labelledby="channel-members-title" data-controller="multi-select">
    <header class="member-panel__header">
      <div class="min-width">
        <h2 id="channel-members-title">Members</h2>
        <p data-member-panel-target="summary">Loading…</p>
      </div>

      <button type="button"
              class="btn member-panel__close"
              aria-label="Close members"
              title="Close members"
              data-member-panel-target="close"
              data-action="member-panel#close">
        <%= image_tag "remove.svg", size: 16, aria: { hidden: "true" } %>
      </button>
    </header>

    <p class="member-panel__status" role="status" data-member-panel-target="status">Open the member list to load members.</p>
    <div class="member-panel__content" data-member-panel-target="content"></div>
    <%= render "shared/multi_select_bar" %>
  </section>

  <%# One shared row menu per panel, configured per row like the shared %>
  <%# message menu: right-click or Shift+F10 opens it for that member. %>
  <div id="member-row-menu" class="member-row-menu border shadow" role="menu" aria-label="Member actions"
      hidden data-member-panel-target="rowMenu" data-action="keydown->member-panel#rowMenuKeydown">
    <button type="button" class="btn member-row-menu__item" role="menuitem"
        data-member-panel-target="rowMenuStar" data-action="member-panel#toggleRowMenuStar">☆ Star</button>
    <span class="for-screen-reader" role="status" data-member-panel-target="rowMenuStatus"></span>
  </div>
</aside>
