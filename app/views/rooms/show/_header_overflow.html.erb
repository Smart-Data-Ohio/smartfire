<%# Room header overflow menu: below 80rem the less-used actions live here
    instead of being silently hidden. Tablets keep notifications and settings
    in the bar; phones move those (and the stage toggle) here too, leaving
    only members, search, call and this button. Items reuse the header
    controls: links navigate to the same paths, the switcher shares its
    body-level action, threads, pins, stage and the help items forward a
    click to the real, hidden control, and notifications names its level
    in an explicit chooser instead of cycling the bell blind. %>
<% membership = room.memberships.find_by(user: Current.user) %>
<% stage_membership = room.stage? ? membership : nil %>
<% involvement = membership&.involvement || room.default_involvement %>
<div class="header-overflow" data-controller="header-overflow"
     data-header-overflow-involvement-url-value="<%= room_involvement_path(room) %>"
     data-header-overflow-involvement-frame-value="<%= dom_id(room, :involvement) %>">
  <button type="button"
          id="header-overflow-button"
          class="btn room-header__action header-overflow__button"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="header-overflow-menu"
          aria-label="More actions"
          title="More actions"
          data-header-overflow-target="button"
          data-action="click->header-overflow#toggle keydown->header-overflow#buttonKeydown">
    <%= image_tag "menu-dots-horizontal.svg", size: 20, aria: { hidden: "true" } %>
    <span class="header-overflow__dot" data-header-overflow-target="dot" hidden aria-hidden="true"></span>
  </button>

  <div id="header-overflow-menu"
       class="room-menu header-overflow__menu"
       popover="manual"
       role="menu"
       aria-label="More actions"
       hidden
       data-header-overflow-target="menu">
    <% unless room.board? || room.direct? %>
      <%# Forwards to the header toggle instead of sharing its action: the
          menu closes back onto the More button first, so the thread panel
          remembers More (not this hidden item) as its focus-return target.
          The browser-toggle target stays so the unread badge updates. %>
      <button type="button" class="btn room-menu__item header-overflow__item" role="menuitem"
              data-action="header-overflow#forward"
              data-header-overflow-forward-value=".room-header__actions .room-header__action--threads"
              data-thread-panel-target="browserToggle">
        <%= image_tag "messages-outlined.svg", size: 20, aria: { hidden: "true" } %>
        <span>Threads</span>
        <span class="room-header__thread-unread" data-thread-panel-unread hidden></span>
      </button>
    <% end %>

    <%= link_to room_events_path(room), class: "btn room-menu__item header-overflow__item", role: "menuitem" do %>
      <%= image_tag "calendar.svg", size: 20, aria: { hidden: "true" } %>
      <span>Events</span>
    <% end %>

    <% unless room.board? %>
      <button type="button" class="btn room-menu__item header-overflow__item" role="menuitem"
              data-action="header-overflow#forward"
              data-header-overflow-forward-value=".room-header__actions [aria-label='Show pinned messages']">
        <%= image_tag "pin.svg", size: 20, aria: { hidden: "true" } %>
        <span>Pins</span>
        <span class="header-overflow__badge" data-header-overflow-target="pinsCount"></span>
      </button>
    <% end %>

    <%= link_to room_files_path(room), class: "btn room-menu__item header-overflow__item", role: "menuitem" do %>
      <%= image_tag "attachment.svg", size: 20, aria: { hidden: "true" } %>
      <span>Files</span>
    <% end %>

    <% if stage_membership %>
      <button type="button" class="btn room-menu__item header-overflow__item header-overflow__item--phone-only" role="menuitem"
              data-action="header-overflow#forward"
              data-header-overflow-forward-value=".room-header__actions [aria-label='Show stage']">
        <span class="stage-panel__glyph" aria-hidden="true">◉</span>
        <span>Stage</span>
      </button>
    <% end %>

    <%# The notification chooser names the current level and submits each
        level explicitly through the involvement endpoint. Forwarding a
        click to the bell would blindly cycle mentions → everything →
        muted → nothing → invisible, hiding the room from the sidebar. %>
    <div class="header-overflow__notifications">
      <button type="button" class="btn room-menu__item header-overflow__item header-overflow__item--phone-only" role="menuitem"
              aria-expanded="false" aria-controls="header-overflow-notifications"
              data-action="header-overflow#toggleNotifications">
        <%= image_tag "notification-bell-#{involvement}.svg", size: 20, aria: { hidden: "true" }, data: { header_overflow_target: "notificationsIcon" } %>
        <span data-header-overflow-target="notificationsLabel">Notifications: <%= short_involvement_label(involvement) %></span>
      </button>
      <div id="header-overflow-notifications" class="header-overflow__submenu" role="group" aria-label="Notification level"
           hidden data-header-overflow-target="notificationsPanel">
        <% involvement_levels_for(room).each do |level| %>
          <button type="button" class="btn room-menu__item header-overflow__submenu-item" role="menuitemradio"
                  aria-checked="<%= level == involvement %>" title="<%= involvement_description(level) %>"
                  data-action="header-overflow#chooseInvolvement"
                  data-header-overflow-level-value="<%= level %>"
                  data-header-overflow-label-value="<%= short_involvement_label(level) %>">
            <span class="header-overflow__check" aria-hidden="true" data-header-overflow-check><%= "✓" if level == involvement %></span>
            <span><%= short_involvement_label(level) %></span>
          </button>
        <% end %>
        <p class="for-screen-reader" role="status" data-header-overflow-target="notificationsStatus"></p>
      </div>
    </div>

    <%= link_to [ :edit, room ], class: "btn room-menu__item header-overflow__item header-overflow__item--phone-only", role: "menuitem" do %>
      <%= image_tag "settings.svg", size: 20, aria: { hidden: "true" } %>
      <span>Room settings</span>
    <% end %>

    <% if Current.user && !Current.user.bot? %>
      <button type="button" class="btn room-menu__item header-overflow__item" role="menuitem"
              data-action="header-overflow#forward"
              data-header-overflow-forward-value="[data-action='help-menu#openShortcuts']">
        <%= image_tag "help-circle.svg", size: 20, aria: { hidden: "true" } %>
        <span>Keyboard shortcuts</span>
      </button>
      <button type="button" class="btn room-menu__item header-overflow__item" role="menuitem"
              data-action="header-overflow#forward"
              data-header-overflow-forward-value="[data-action='help-menu#restartTour']">
        <%= image_tag "refresh.svg", size: 20, aria: { hidden: "true" } %>
        <span>Restart tour</span>
      </button>
    <% end %>

    <button type="button" class="btn room-menu__item header-overflow__item" role="menuitem"
            aria-label="Quick switcher"
            data-action="click->keyboard-shortcuts#openSwitcher header-overflow#closeAfterActivate">
      <%= image_tag "transfer.svg", size: 20, aria: { hidden: "true" } %>
      <span>Quick switcher</span>
    </button>
  </div>
</div>
