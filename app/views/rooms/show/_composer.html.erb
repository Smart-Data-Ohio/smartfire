<% thread = local_assigns[:thread] %>
<% inline = local_assigns.fetch(:inline, false) %>
<% reply_notify_id = dom_id(thread || room, :reply_notify) %>
<% composer_markup = capture do %>
  <div class="composer position-relative"
      data-controller="typing-notifications"
      data-typing-notifications-active-class="typing-indicator--active"
      data-typing-notifications-room-id-value="<%= room.id %>"
      data-typing-notifications-thread-id-value="<%= thread&.id %>">
    <turbo-frame id="<%= thread ? dom_id(thread, :composer_frame) : "composer-frame" %>" class="composer__frame min-width">
      <%= composer_form_tag(room, thread:) do |form| %>
        <fieldset data-composer-target="fields" contents>
          <div class="composer__stack">
            <div class="composer__context" hidden aria-live="polite" data-composer-target="context">
              <div class="composer__context-copy min-width">
                <span class="composer__context-label" data-composer-target="contextLabel"></span>
                <span class="composer__context-preview overflow-ellipsis" data-composer-target="contextPreview"></span>
                <span class="composer__feedback" role="alert" data-composer-target="feedback" hidden></span>
              </div>

              <label class="composer__reply-notify" for="<%= reply_notify_id %>" hidden data-composer-target="notifyControl">
                <input id="<%= reply_notify_id %>" type="checkbox" name="message[reply_notify_author]" value="1" checked disabled data-composer-target="replyNotify"
                       data-action="change->composer#notifyChanged" />
                <span>Notify author</span>
              </label>

              <button type="button" class="btn btn--borderless composer__context-cancel"
                      aria-label="Cancel message context" title="Cancel"
                      data-action="composer#cancelContext">
                <%= image_tag "remove.svg", size: 18, class: "colorize--black", aria: { hidden: "true" } %>
              </button>
            </div>

            <%= form.hidden_field :reply_to_message_id, data: { composer_target: "replyTo" }, autocomplete: "off" %>
            <div class="composer__filelist flex flex--align-center gap flex-wrap" data-composer-target="fileList"></div>
            <%# Pending Drive attachment chips, added by the drive-picker; keep empty so :empty hides the strip. %><div class="composer__drive-attachments" aria-live="polite"></div>

            <div class="composer__surface flex align-end gap">
              <%# The + button owns a menu (From this device / From Google
                  Drive) exactly when the composer renders a Drive flow
                  below; otherwise it opens the device picker directly. %>
              <% attach_menu_id = thread ? dom_id(thread, :attach_menu) : "attach-menu" %>
              <% drive_menu_available = drive_share_picker_available? || Current.user&.google_account&.drive? %>
              <div class="composer__attach flex-item-no-shrink" data-controller="attach-menu">
                <button type="button" class="btn btn--borderless composer__attachment-btn"
                        title="Attach a file" aria-label="Attach a file"
                        <% if drive_menu_available %>aria-haspopup="menu" aria-expanded="false" aria-controls="<%= attach_menu_id %>"<% end %>
                        data-attach-menu-target="button"
                        data-action="click->attach-menu#toggle keydown->attach-menu#buttonKeydown">
                  <span class="composer__attachment-mark" aria-hidden="true">+</span>
                </button>
                <input type="file" class="attach-menu__file" tabindex="-1" aria-hidden="true" multiple
                       data-attach-menu-target="fileInput" data-action="composer#filePicked" />
                <% if drive_menu_available %>
                  <div id="<%= attach_menu_id %>" class="room-menu attach-menu" popover="manual"
                       role="menu" aria-label="Attach a file" hidden data-attach-menu-target="menu">
                    <button type="button" class="btn room-menu__item attach-menu__item" role="menuitem"
                            data-action="attach-menu#chooseDevice">
                      From this device
                    </button>
                    <button type="button" class="btn room-menu__item attach-menu__item" role="menuitem"
                            data-action="attach-menu#chooseDrive">
                      From Google Drive
                    </button>
                  </div>
                <% end %>
              </div>

              <%# Drive flows without their own buttons: the attach menu's
                  "From Google Drive" item starts them, and these wrappers
                  anchor their panels exactly as before. %>
              <% if drive_share_picker_available? %>
                <div class="drive-share flex-item-no-shrink" data-controller="drive-share"
                     data-drive-share-room-id-value="<%= room.id %>"
                     data-drive-share-thread-id-value="<%= thread&.id %>">
                  <div class="drive-share__panel" role="dialog" aria-label="Share a Drive file" hidden
                       data-drive-share-target="panel" data-action="keydown->drive-share#panelKey"></div>
                </div>
              <% elsif Current.user&.google_account&.drive? %>
                <div class="drive-picker flex-item-no-shrink" data-controller="drive-picker">
                  <div class="drive-picker__panel" role="dialog" aria-label="Find a Drive file" hidden
                       data-drive-picker-target="panel" data-action="keydown->drive-picker#key">
                    <input type="text" class="drive-picker__search input" placeholder="Search Drive files"
                           autocomplete="off" autocapitalize="off" spellcheck="false"
                           role="combobox" aria-label="Search Drive files" aria-expanded="false" aria-autocomplete="list"
                           data-drive-picker-target="search" data-action="input->drive-picker#search" />
                    <ul class="drive-picker__results" role="listbox" aria-label="Drive files" data-drive-picker-target="results"></ul>
                    <p class="drive-picker__status txt-small" role="status" hidden data-drive-picker-target="status"></p>
                  </div>
                </div>
              <% end %>

              <div class="composer__editor min-width flex-item-grow" data-controller="markdown-editor">
                <%= form.text_area :markdown_source,
                      rows: 1,
                      maxlength: 50_000,
                      class: "composer__textarea input",
                      placeholder: thread ? "Reply in #{thread.name}" : "Message ##{room_display_name(room)}",
                      role: "combobox",
                      aria: { multiline: "true", label: thread ? "Write a thread reply" : "Write a message",
                        autocomplete: "list", expanded: "false" },
                      data: {
                        controller: "markdown-autocomplete",
                        action: "input->markdown-editor#resize input->markdown-autocomplete#search input->typing-notifications#start input->composer#saveDraft focus->markdown-autocomplete#focus blur->markdown-autocomplete#blur keydown->markdown-editor#shortcut keydown->composer#submitByKeyboard",
                        markdown_autocomplete_url_value: autocompletable_users_path(room_id: room.id),
                        markdown_autocomplete_icons_url_value: autocompletable_icons_path,
                        markdown_autocomplete_slash_commands_url_value: autocompletable_slash_commands_path(room_id: room.id, thread_id: thread&.id),
                        markdown_editor_target: "source",
                        composer_target: "markdown",
                        suggestion_results_placement: "above" } %>
              </div>

              <%= render "scheduled_messages/composer_button", room: room, thread: thread %>

              <%= form.button name: "send", type: "submit", data: { action: "composer#submit", composer_target: "send" },
                    class: "composer__send btn btn--reversed flex-item-no-shrink" do %>
                <%= image_tag "arrow-up.svg", size: 17, aria: { hidden: "true" } %>
                <span class="for-screen-reader"><%= thread ? "Send Reply" : "Send Message" %></span>
              <% end %>
            </div>
          </div>
        </fieldset>

        <div class="typing-indicator gap txt-small align-center flex-inline" data-typing-notifications-target="indicator">
          <div class="typing-indicator__author spinner" data-typing-notifications-target="author"></div>
        </div>

        <%= form.hidden_field :client_message_id, data: { composer_target: "clientid" } %>
      <% end %>
    </turbo-frame>
  </div>
<% end %>

<% if inline %>
  <%= composer_markup %>
<% else %>
  <% content_for :footer do %>
    <%= composer_markup %>
  <% end %>
<% end %>
