<div id="<%= dom_id(room, :stage_controls) %>" class="stage-panel__controls">
  <% stream = room.live_stream %>
  <% if stream %>
    <div class="stage-panel__live" data-stream-id="<%= stream.id %>">
      <p class="stage-panel__note stage-panel__note--live">Live: <%= stream.user.name %></p>
      <% if stream.membership_id == membership.id || membership.host? %>
        <%= button_to "Stop stream", room_stage_stream_path(room), method: :delete,
              params: { stream_id: stream.id },
              class: "btn stage-panel__stop",
              form: { data: { action: "turbo:submit-end->stage-panel#streamStopSubmitted", room_id: room.id } } %>
      <% end %>
    </div>
  <% elsif membership.host? || membership.speaker? %>
    <%= form_with url: room_stage_stream_path(room), method: :post, class: "stage-panel__stream-form",
          data: { room_id: room.id } do |form| %>
      <div class="stage-panel__stream-quality">
        <%= form.label :quality, "Stream quality" %>
        <%= form.select :quality, options_for_select(Stream::QUALITIES.map { |quality| [ quality, quality ] }, "1080p15"), {}, class: "input" %>
      </div>
      <%# The click hands the whole go-live sequence to the huddle panel,
          which captures the screen inside this gesture before POSTing.
          Without the panel the form submits on its own, as before. %>
      <%= form.submit "Go live", class: "btn btn--reversed stage-panel__go-live",
            data: { action: "click->stage-panel#goLive" } %>
    <% end %>
  <% end %>
  <% if membership.listener? %>
    <% if membership.hand_raised? %>
      <p class="stage-panel__note">Your hand is raised. A host can invite you to speak.</p>
      <%= button_to "Lower hand", room_stage_hand_path(room), method: :delete, class: "btn stage-panel__hand" %>
    <% else %>
      <p class="stage-panel__note">You are in the audience.</p>
      <%= button_to "Raise hand", room_stage_hand_path(room), method: :post, class: "btn stage-panel__hand" %>
    <% end %>
  <% elsif membership.speaker? %>
    <p class="stage-panel__note">You are speaking. Join the stage to be heard.</p>
  <% else %>
    <p class="stage-panel__note">You are hosting this stage.</p>
  <% end %>
</div>
