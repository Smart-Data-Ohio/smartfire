<%= render layout: "rooms/layouts/edit", locals: { room: @room } do %>
  <%= render "rooms/boards/form",
        room: @room, selected_users: @selected_users, unselected_users: @unselected_users %>
<% end %>

<% if Current.user.can_administer?(@room) %>
  <section class="panel txt-align-center">
    <%= link_to "Board automations", board_automations_path(@room), class: "btn" %>
  </section>
<% end %>
