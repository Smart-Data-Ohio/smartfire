<% stats = run.stats || {} %>
<% users = stats["users"] || {} %>
<% counts = stats["counts"] || {} %>
<dl class="flex flex-column gap-half">
  <div class="flex gap"><dt><strong>Status</strong></dt><dd class="margin-none"><%= run.status %></dd></div>
  <% if stats["phase"].present? %>
    <div class="flex gap"><dt><strong>Phase</strong></dt><dd class="margin-none"><%= stats["phase"] %></dd></div>
  <% end %>
  <% if stats["current"].present? %>
    <div class="flex gap"><dt><strong>Working on</strong></dt><dd class="margin-none"><%= stats["current"] %></dd></div>
  <% end %>
  <% if defined?(queued_behind) && queued_behind %>
    <div class="flex gap"><dt><strong>Queue</strong></dt><dd class="margin-none">Queued behind another import.</dd></div>
  <% end %>
  <% if users.any? %>
    <div class="flex gap"><dt><strong>People</strong></dt><dd class="margin-none"><%= users["total"] %> found (<%= users["matched"] %> matched, <%= users["placeholders"] %> placeholders, <%= users["deactivated"] %> deactivated, <%= users["bots"] %> bots)</dd></div>
  <% end %>
  <% if counts.any? %>
    <div class="flex gap"><dt><strong>Rooms</strong></dt><dd class="margin-none"><%= counts["rooms_created"] %> created, <%= counts["rooms_merged"] %> merged</dd></div>
    <div class="flex gap"><dt><strong>Messages</strong></dt><dd class="margin-none"><%= counts["messages"] %> messages, <%= counts["replies"] %> replies in <%= counts["threads"] %> threads</dd></div>
    <div class="flex gap"><dt><strong>Extras</strong></dt><dd class="margin-none"><%= counts["reactions"] %> reactions, <%= counts["pins"] %> pins, <%= counts["files_linked"] %> files linked, <%= counts["skipped"] %> skipped</dd></div>
  <% end %>
  <% if stats["api_calls"] %>
    <div class="flex gap"><dt><strong>Slack API calls</strong></dt><dd class="margin-none"><%= stats["api_calls"] %></dd></div>
  <% end %>
  <div class="flex gap"><dt><strong>Issues</strong></dt><dd class="margin-none"><%= stats["issues_count"] || run.issues.count %></dd></div>
  <div class="flex gap"><dt><strong>Started</strong></dt><dd class="margin-none"><%= run.started_at || run.created_at %></dd></div>
  <% if run.finished_at %>
    <div class="flex gap"><dt><strong>Finished</strong></dt><dd class="margin-none"><%= run.finished_at %></dd></div>
  <% end %>
</dl>
<% if run.error.present? %>
  <p role="alert"><strong>Error:</strong> <%= run.error %></p>
<% end %>
