<% @page_title = slack_run_title(@run) %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to slack_imports_path %>
  </div>
<% end %>

<div class="panel panel--wide flex flex-column gap slack-import">
  <h1 class="margin-none"><%= slack_run_title(@run) %></h1>

  <turbo-frame id="slack_import_run" src="<%= status_slack_import_path(@run) %>"<% if @run.active? %> data-controller="frame-poll"<% end %>>
    <%= render "slack/import_runs/status_section", run: @run, queued_behind: @queued_behind %>
  </turbo-frame>

  <div class="flex gap">
    <% if @run.cancellable? %>
      <%= button_to "Cancel run", cancel_slack_import_path(@run), class: "btn btn--negative",
            form: { data: { turbo_confirm: "Cancel this run? It stops at the next step." } } %>
    <% end %>
    <% if @run.undoable? %>
      <%= button_to "Undo import", undo_slack_import_path(@run), class: "btn btn--negative",
            form: { data: { turbo_confirm: "Undo this import? Every room, message, reaction, and pin it created is removed. Records it only matched to existing accounts or rooms stay." } } %>
    <% end %>
  </div>

  <% if @run.dry_run? && @run.completed? && @conversations.any? %>
    <%= form_with url: slack_imports_path, data: { controller: "check-all" }, class: "flex flex-column gap" do |form| %>
      <%= form.hidden_field :mode, value: "import" %>
      <%= form.hidden_field :dry_run_id, value: @run.id %>
      <section aria-labelledby="run-plan" class="fill-shade border-radius pad flex flex-column gap">
        <h2 id="run-plan" class="margin-none">Your plan</h2>
        <div class="flex gap">
          <button type="button" class="btn" data-action="check-all#checkAll">Select all</button>
          <button type="button" class="btn" data-action="check-all#checkNone">Select none</button>
        </div>
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="for-screen-reader">Import?</span></th>
              <th scope="col">Conversation</th>
              <th scope="col">Type</th>
              <th scope="col">Members</th>
              <th scope="col">Messages</th>
              <th scope="col">Threads</th>
            </tr>
          </thead>
          <tbody>
            <% @conversations.each do |conversation| %>
              <tr>
                <td>
                  <%= check_box_tag "conversation_ids[]", conversation["id"], true,
                        id: "conversation_#{conversation["id"]}", data: { check_all_target: "checkbox" },
                        aria: { label: "Import #{conversation["name"]}" } %>
                </td>
                <td><label for="conversation_<%= conversation["id"] %>"><%= conversation["name"] %></label></td>
                <td><%= slack_conversation_type_label(conversation["type"]) %></td>
                <td><%= conversation["members"] %></td>
                <td><%= conversation["messages"] %></td>
                <td><%= conversation["threads"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <div>
          <%= form.submit "Import checked", class: "btn btn--primary",
                data: { turbo_confirm: "Import the checked conversations? It can be undone." } %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
