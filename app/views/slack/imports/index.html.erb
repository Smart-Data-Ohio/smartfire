<% @page_title = "Import from Slack" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to user_profile_path %>
  </div>
<% end %>

<div class="panel panel--wide flex flex-column gap slack-import">
  <h1 class="margin-none">Import from Slack</h1>

  <% if @workspace&.team_id.blank? %>
    <p>An administrator needs to set up Slack import first.</p>
  <% else %>
    <p class="margin-none">Bring your Slack history into Smartfire: your direct messages, group DMs, and the private channels you're in. Each one becomes visible in Smartfire to the other members of it. Public channels come over with the workspace import instead.</p>

    <section aria-labelledby="slack-personal-connection" class="fill-shade border-radius pad">
      <h2 id="slack-personal-connection" class="margin-none">Your Slack connection</h2>
      <% if @connection&.connected? %>
        <p>Connected. Reconnect to refresh the grant.</p>
        <div class="flex gap">
          <%= link_to "Reconnect Slack", slack_oauth_start_path(return_to: slack_imports_path), class: "btn" %>
          <%= button_to "Disconnect Slack", slack_connection_path(return_to: slack_imports_path), method: :delete, class: "btn btn--negative",
                form: { data: { turbo_confirm: "Disconnect Slack? Your imported history stays." } } %>
        </div>
      <% else %>
        <% if @connection %>
          <p>Slack rejected the connection<% if @connection.disconnected_reason.present? %> (<%= @connection.disconnected_reason %>)<% end %>. Reconnect below.</p>
        <% else %>
          <p>Connect with your Slack account to preview and import your history.</p>
        <% end %>
        <p><%= link_to "Connect Slack", slack_oauth_start_path(return_to: slack_imports_path), class: "btn btn--primary" %></p>
      <% end %>
    </section>

    <% if @connection&.connected? %>
      <section aria-labelledby="slack-personal-start" class="fill-shade border-radius pad">
        <h2 id="slack-personal-start" class="margin-none">Preview</h2>
        <p>A preview reads your DMs, group DMs, and private channels and shows what an import would bring over. It writes nothing.</p>
        <%= button_to "Start preview", slack_imports_path, params: { mode: "dry_run" }, class: "btn btn--reversed" %>
      </section>
    <% end %>

    <section aria-labelledby="slack-personal-runs" class="fill-shade border-radius pad">
      <h2 id="slack-personal-runs" class="margin-none">Your imports</h2>
      <% if @runs.any? %>
        <table>
          <thead>
            <tr>
              <th scope="col">Run</th>
              <th scope="col">Mode</th>
              <th scope="col">Status</th>
              <th scope="col">When</th>
            </tr>
          </thead>
          <tbody>
            <% @runs.each do |run| %>
              <tr>
                <td><%= link_to "##{run.id}", slack_import_path(run) %></td>
                <td><%= run.mode %></td>
                <td><%= run.status %></td>
                <td><%= run.created_at %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p>No personal imports yet.</p>
      <% end %>
    </section>
  <% end %>
</div>
