<li class="flex flex-column gap flush fill-shade border-radius pad-block pad-inline-double">
  <div class="flex align-center gap">
    <div class="min-width flex-item-grow">
      <div class="overflow-ellipsis txt-large"><strong><%= event.event_type %></strong> · <%= event.outcome %></div>
      <div class="overflow-ellipsis txt-small">
        <%= local_datetime_tag event.created_at, style: :datetime %>
        <% if event.room %> · <%= room_display_name(event.room) %><% end %>
        <% if event.actor %> · from <%= event.actor.name %><% end %>
        <% if event.message_id %> · message #<%= event.message_id %><% end %>
        <% if event.hop.positive? %> · hop <%= event.hop %><% end %>
      </div>
      <% if event.detail.present? %>
        <div class="txt-small"><%= event.detail %></div>
      <% end %>
      <% if event.webhook_status != "none" %>
        <div class="txt-small">Webhook <%= event.webhook_status %><% if event.webhook_attempts.to_i.positive? %> · <%= pluralize(event.webhook_attempts, "attempt") %><% end %><% if event.webhook_last_error.present? %> · <%= event.webhook_last_error %><% end %></div>
      <% end %>
      <% if event.event_type == "github_action_completed" && event.metadata.is_a?(Hash) %>
        <div class="txt-small">GitHub <%= event.metadata["action"] %>: <%= event.metadata["status"] %><% if event.metadata["message"].present? %> — <%= event.metadata["message"] %><% end %></div>
      <% end %>
      <% if event.event_type == "fizzy_action_completed" && event.metadata.is_a?(Hash) %>
        <div class="txt-small">Fizzy <%= event.metadata["action"] %>: <%= event.metadata["status"] %><% if event.metadata["message"].present? %> — <%= event.metadata["message"] %><% end %></div>
      <% end %>
      <% if event.event_type == "work_handed_off" && event.metadata.is_a?(Hash) && event.metadata["handoff"].is_a?(Hash) %>
        <div class="txt-small">Handoff: <%= truncate(event.metadata["handoff"]["summary"].to_s, length: 140) %></div>
      <% end %>
      <% if agent_event_content_visible?(@agent, event, Current.user) %>
        <div class="txt-small overflow-ellipsis"><%= truncate(event.message.plain_text_body, length: 140) %></div>
      <% else %>
        <div class="txt-small">Content unavailable</div>
      <% end %>
    </div>
  </div>
</li>
