<% @page_title = @query ? "Search: #{@query}" : "Search" %>
<% @body_class = "sidebar searches" %>

<%# The query itself lives in the header search field (layouts/_global_search),
    prefilled here; this page shows what it found, top down. %>
<% content_for :nav do %>
  <div class="room-header__identity room--current min-width">
    <span class="room-header__kind">Search</span>
    <h1 id="search-title" class="room__contents">
      <span class="room-header__name overflow-ellipsis"><%= @query ? "“#{@query}”" : "Search" %></span>
    </h1>
  </div>
<% end %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<section id="message-area" class="searches__page" aria-labelledby="search-title">
  <div class="searches__bar">
    <% if @return_to_room %>
      <%= link_to room_path(@return_to_room), class: "btn searches__back" do %>
        <%= image_tag "arrow-left.svg", size: 16, aria: { hidden: "true" }, class: "colorize--black" %>
        <span class="overflow-ellipsis">Back to <%= room_display_name(@return_to_room) %></span>
      <% end %>
    <% end %>

    <% if @query %>
      <p class="searches__summary">
        <%= @messages.size %><%= "+" if @has_more_older %> <%= "message".pluralize(@messages.size) %>
      </p>
    <% end %>
  </div>

  <% if @query %>
    <%= render "searches/filters" %>
    <%= render "searches/sections" %>

    <% if @messages.empty? && @board_posts.empty? && @work_threads.empty? && @events.empty? %>
      <p class="searches__empty">No messages match “<%= @query %>”.</p>
    <% end %>
  <% else %>
    <div class="searches__start">
      <p class="searches__hint">
        Search from the bar at the top of any page (press <kbd>/</kbd>).
        Narrow results with <code>from:@name</code>, <code>in:#room</code>, <code>has:file</code>, <code>before:2026-01-31</code> or <code>is:thread</code>.
      </p>

      <div id="search-recents" class="searches__recents-wrap">
        <%= render "searches/page_recents", searches: @recent_searches %>
      </div>
    </div>
  <% end %>

  <% if @has_more_older %>
    <%= render "searches/load_older", query: params[:q], oldest_id: @messages.first.id %>
  <% end %>

  <%= search_results_tag do %>
    <%= render partial: "messages/message", collection: @messages, locals: { show_room_icon: true } %>
  <% end %>
</section>
