<%# Always rendered, even with no cards: edits broadcast-replace this
    container, so a URL added by an edit needs the target to exist and a
    removed URL needs its cards cleared. The ERB tags hug the div so the
    empty container has no text nodes and the :empty rule hides it.
    Frames carry no card content, so the container is identical for every
    viewer; each frame loads through the per-viewer card endpoint. %>
<% cards = fizzy_cards_for(message) %><div id="<%= dom_id(message, :fizzy_cards) %>" class="fizzy-cards"><% cards.each do |card| %>
  <%= turbo_frame_tag fizzy_card_frame_id(card, message_id: message.id),
        src: room_fizzy_card_path(message.room_id, card, message_id: message.id),
        loading: "lazy", class: "fizzy-card-frame" %>
<% end %></div>
