<%# A full-page submit: Turbo Drive leaves <html> attributes untouched, %>
<%# so only a fresh render picks up the new data-theme without a flash. %>
<%= form_with model: @user, url: user_profile_path, method: :patch, data: { turbo: false }, class: "flex flex-column gap" do |form| %>
  <fieldset class="margin-none">
    <legend class="txt-large">Appearance</legend>

    <div role="radiogroup" aria-label="Theme" class="flex align-center gap pad-block-half">
      <% [ [ "Light", "light" ], [ "Dark", "dark" ], [ "System", "system" ] ].each do |label, value| %>
        <label class="txt-medium">
          <%= form.radio_button :theme, value, checked: @user.theme == value, id: "user_theme_#{value}" %>
          <%= label %>
        </label>
      <% end %>
    </div>
    <% if @user.errors[:theme].any? %>
      <p class="txt-small margin-none" style="color: var(--color-negative)">Theme <%= @user.errors[:theme].to_sentence %>.</p>
    <% end %>

    <div class="flex align-center gap pad-block-half">
      <%= form.label :time_zone, "Time zone", class: "txt-medium" %>
      <%= form.time_zone_select :time_zone, nil, { include_blank: "Not set (use system)" },
            { class: "input flex-item-grow", id: "user_time_zone" } %>
    </div>
    <p class="txt-small margin-none">Detected from your browser on first visit. Times, reminders, and quiet hours use it.</p>
    <% if @user.errors[:time_zone].any? %>
      <p class="txt-small margin-none" style="color: var(--color-negative)">Time zone <%= @user.errors[:time_zone].to_sentence %>.</p>
    <% end %>

    <%= profile_form_submit_button %>
  </fieldset>
<% end %>
