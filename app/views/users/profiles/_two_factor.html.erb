<fieldset>
  <legend class="gap">
    <%= image_tag "key.svg", aria: { hidden: "true" }, size: 36, class: "colorize--black" %>
  </legend>

  <div class="flex flex-column gap">
    <h2 class="margin-none txt-large">Two-step sign-in</h2>

    <% if (credential = user.two_factor_credential)&.enabled? %>
      <p class="txt-medium margin-none">On since <%= credential.confirmed_at.to_date.to_fs(:long) %>. Signing in asks for your authenticator code.</p>

      <div class="flex align-center gap">
        <%# Full-page post like setup: the response renders the one-time codes
            with a plain 200. No confirm: a Turbo-disabled form cannot show
            one, and the fresh set appears right away. %>
        <%= button_to "New backup codes", two_factor_backup_codes_path, method: :post, class: "btn txt-small",
              data: { turbo: false } %>
        <%= button_to "Disable", two_factor_setup_path, method: :delete, class: "btn btn--negative txt-small",
              data: { turbo_confirm: "Turn off two-step sign-in? You will have to set it up again right away." } %>
      </div>

      <h3 class="margin-none txt-medium">Remembered devices</h3>
      <% if @two_factor_devices.any? %>
        <menu class="flex flex-column gap margin-none pad-none">
          <% @two_factor_devices.each do |device| %>
            <li class="flex align-center gap margin-none" id="<%= dom_id(device) %>">
              <div class="min-width flex-item-grow txt-small">
                <div class="overflow-ellipsis"><strong><%= device.user_agent.presence || "Unknown browser" %></strong></div>
                <div class="txt-subtle"><%= [ device.ip_address, ("last used #{time_ago_in_words(device.last_used_at)} ago" if device.last_used_at) ].compact.join(" · ") %></div>
              </div>
              <%= button_to "Revoke", two_factor_remembered_device_path(device), method: :delete,
                    class: "btn btn--negative txt-small flex-item-no-shrink" %>
            </li>
          <% end %>
        </menu>
      <% else %>
        <p class="txt-small margin-none">No remembered devices. Tick "Remember this device" when signing in to skip the code on this browser for 30 days.</p>
      <% end %>
    <% else %>
      <p class="txt-medium margin-none">Not set up yet.</p>
      <%= link_to "Set up two-step sign-in", two_factor_setup_path, class: "btn btn--reversed" %>
    <% end %>
  </div>
</fieldset>
