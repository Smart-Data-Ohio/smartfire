<%= turbo_frame_tag "user_card" do %>
  <div class="status-popup">
    <h2 class="status-popup__title">Set a status</h2>

    <%= form_with model: @user, url: user_status_path, method: :patch, class: "flex flex-column",
          data: { action: "turbo:submit-end->profile-card#statusSaved" } do |form| %>
      <%= render "users/statuses/fields", form:, user: @user, id_prefix: "status_popup" %>

      <%# Save comes first so Enter in a field saves rather than clears. %>
      <div class="status-popup__actions">
        <%= form.button "Save", class: "btn btn--reversed" %>
        <%= form.button "Clear status", name: "user[clear_custom_status]", value: "1", class: "btn" %>
        <%= link_to "Cancel", user_card_path(@user), class: "btn" %>
      </div>
    <% end %>
  </div>
<% end %>
