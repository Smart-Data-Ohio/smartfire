<% @page_title = "People" %>
<% @body_class = "sidebar workspace-page" %>

<% content_for :nav do %>
  <div class="room-header__identity room--current min-width">
    <span class="room-header__kind">Workspace</span>
    <h1 id="people-title" class="room__contents">
      <span class="room-header__name">People</span>
    </h1>
  </div>
<% end %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<section class="panel panel--wide txt-align-center flex flex-column gap" aria-labelledby="people-title">
  <div class="pad-inline-double center">
    <p class="margin-none">
      Everyone in the workspace. Select people to message them or start a huddle.
    </p>
  </div>

  <div class="pad-inline txt-align-start" data-controller="multi-select">
    <% if @users.any? %>
      <ul class="people-directory">
        <% @users.each do |user| %>
          <li class="people-directory__row multi-select-row"
              data-action="touchstart->multi-select#pressStart touchmove->multi-select#pressMove touchend->multi-select#pressEnd contextmenu->multi-select#suppressMenu">
            <input type="checkbox" id="select_user_<%= user.id %>" data-multi-select-target="checkbox" data-action="click->multi-select#toggle"
                data-user-id="<%= user.id %>" data-bot="<%= user.bot? %>" aria-label="Select <%= user.name %>">
            <%= avatar_tag user, size: 32 %>
            <span class="people-directory__identity min-width">
              <%= button_tag type: "button", class: "profile-card-name overflow-ellipsis", data: profile_card_trigger(user) do %>
                <strong><%= user.name %></strong>
              <% end %>
              <span class="people-directory__presence"><%= user.online_now?(@online_ids) ? "Online" : "Offline" %></span>
            </span>
            <% if @starred_ids.include?(user.id) %>
              <span class="profile-card__badge" role="img" aria-label="Starred by you" title="Starred by you">★</span>
            <% end %>
            <% if user.agent %>
              <span class="profile-card__badge">Agent</span>
            <% elsif user.bot? %>
              <span class="profile-card__badge">Bot</span>
            <% end %>
          </li>
        <% end %>
      </ul>

      <%= render "shared/multi_select_bar" %>
    <% else %>
      <p class="txt-small">Nobody else is here yet.</p>
    <% end %>
  </div>
</section>
