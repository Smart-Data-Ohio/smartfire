<% @page_title = "Import plan" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to account_slack_import_run_path(@run) %>
  </div>
<% end %>

<div class="panel panel--wide flex flex-column gap slack-import">
  <h1 class="margin-none">Import plan</h1>
  <p class="margin-none">From dry run #<%= @run.id %>: choose what to import and where it goes. Unchecked conversations and “Skip” targets stay in Slack only.</p>

  <%= form_with url: start_import_account_slack_import_run_path(@run), data: { controller: "check-all" }, class: "flex flex-column gap" do |form| %>
    <div class="flex gap">
      <button type="button" class="btn" data-action="check-all#checkAll">Select all</button>
      <button type="button" class="btn" data-action="check-all#checkNone">Select none</button>
    </div>

    <table>
      <thead>
        <tr>
          <th scope="col"><span class="for-screen-reader">Import?</span></th>
          <th scope="col">Conversation</th>
          <th scope="col">Type</th>
          <th scope="col">Archived</th>
          <th scope="col">Members</th>
          <th scope="col">Messages</th>
          <th scope="col">Threads</th>
          <th scope="col">Target</th>
        </tr>
      </thead>
      <tbody>
        <% @conversations.each do |conversation| %>
          <% target = conversation["target"] || {} %>
          <% selected = target["action"] == "skip" ? "skip" : target["action"] == "merge" && @rooms.any? { |room| room.id == target["room_id"] } ? target["room_id"].to_s : "new" %>
          <tr>
            <td>
              <%= check_box_tag "conversation_ids[]", conversation["id"], true,
                    id: "conversation_#{conversation["id"]}", data: { check_all_target: "checkbox" },
                    aria: { label: "Import #{conversation["name"]}" } %>
            </td>
            <td><label for="conversation_<%= conversation["id"] %>"><%= conversation["name"] %></label></td>
            <td><%= slack_conversation_type_label(conversation["type"]) %></td>
            <td><%= conversation["archived"] ? "Yes" : "No" %></td>
            <td><%= conversation["members"] %></td>
            <td><%= conversation["messages"] %></td>
            <td><%= conversation["threads"] %></td>
            <td>
              <%= select_tag "room_targets[#{conversation["id"]}]",
                    options_for_select(
                      [ [ "New room", "new" ] ] +
                      @rooms.map { |room| [ room.name, room.id.to_s ] } +
                      [ [ "Skip", "skip" ] ],
                      selected
                    ),
                    aria: { label: "Target for #{conversation["name"]}", describedby: "plan-target-note" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p id="plan-target-note" class="margin-none txt-small">“New room” creates a room named after the conversation; pick a room to merge into it; “Skip” leaves the conversation out.</p>

    <section aria-labelledby="plan-samples" class="fill-shade border-radius pad">
      <h2 id="plan-samples" class="margin-none">Converted samples</h2>
      <p class="margin-none">Slack text on the left, the Markdown Smartfire will show on the right.</p>
      <% if @samples.any? %>
        <table>
          <thead>
            <tr>
              <th scope="col">Conversation</th>
              <th scope="col">Slack text</th>
              <th scope="col">Smartfire preview</th>
            </tr>
          </thead>
          <tbody>
            <% @samples.each do |sample| %>
              <tr>
                <td><%= sample["conversation"] %></td>
                <td style="white-space: pre-wrap;"><%= sample["slack_text"] %></td>
                <td><%= slack_sample_html(sample["markdown"]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p>No samples in this dry run.</p>
      <% end %>
    </section>

    <section aria-labelledby="plan-start" class="fill-shade border-radius pad flex flex-column gap">
      <h2 id="plan-start" class="margin-none">Start the import</h2>
      <div class="flex gap">
        <label class="flex flex-column gap">
          <span class="txt-small"><strong>Oldest message</strong> <span class="txt-subtle">(test import only)</span></span>
          <%= form.date_field :oldest, class: "input", value: 14.days.ago.to_date %>
        </label>
        <label class="flex flex-column gap">
          <span class="txt-small"><strong>Latest message</strong> <span class="txt-subtle">(test import only)</span></span>
          <%= form.date_field :latest, class: "input" %>
        </label>
      </div>
      <div class="flex gap">
        <%= form.button "Test import", name: "preset", value: "test", class: "btn btn--primary",
              data: { turbo_confirm: "Start a test import of the checked conversations (recent messages only)? It can be undone." } %>
        <%= form.button "Full import", name: "preset", value: "full", class: "btn btn--reversed",
              data: { turbo_confirm: "Start the full import of the checked conversations (all messages)? It can be undone." } %>
      </div>
      <p class="margin-none txt-small"><strong>Test import</strong> imports the checked conversations' recent messages and can be undone. <strong>Full import</strong> imports everything in the checked conversations, with no date bounds.</p>
    </section>
  <% end %>
</div>
