<% @page_title = slack_run_title(@run) %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to account_slack_import_runs_path %>
  </div>
<% end %>

<div class="panel panel--wide flex flex-column gap">
  <h1 class="margin-none"><%= slack_run_title(@run) %></h1>
  <p class="margin-none">Started by <%= @run.user.name %> <%= @run.created_at %>.</p>

  <turbo-frame id="slack_import_run" src="<%= account_slack_import_run_path(@run) %>"<% if @run.active? %> data-controller="frame-poll"<% end %>>
    <section aria-labelledby="run-status" class="fill-shade border-radius pad">
      <h2 id="run-status" class="margin-none">Status</h2>
      <%= render "slack/import_runs/status", run: @run, queued_behind: @queued_behind %>
    </section>
  </turbo-frame>

  <div class="flex gap">
    <% if @run.cancellable? %>
      <%= button_to "Cancel run", cancel_account_slack_import_run_path(@run), class: "btn btn--negative",
            form: { data: { turbo_confirm: "Cancel this run? It stops at the next step; already-imported records stay until undone." } } %>
    <% end %>
    <% if @run.undoable? %>
      <%= button_to "Undo import", undo_account_slack_import_run_path(@run), class: "btn btn--negative",
            form: { data: { turbo_confirm: "Undo this import? Every room, message, reaction, and pin it created is removed. Records it only matched to existing accounts or rooms stay." } } %>
    <% end %>
    <% if @run.workspace? && @run.dry_run? && @run.completed? %>
      <%= link_to "Review the plan", plan_account_slack_import_run_path(@run), class: "btn btn--primary" %>
    <% end %>
    <% if @run.workspace? && @run.import? && @run.completed? %>
      <%= button_to "Run catch-up import", catch_up_account_slack_import_run_path(@run), class: "btn",
            form: { data: { turbo_confirm: "Run a catch-up import with the same conversations and targets? Already-imported objects are skipped, so it is safe to repeat." } } %>
    <% end %>
  </div>
  <% if @run.workspace? && @run.import? && @run.completed? %>
    <p class="margin-none txt-small">Catch-up repeats this import's conversations and targets to pick up what changed in Slack since. Already-imported objects are skipped, never duplicated.</p>
  <% end %>

  <section aria-labelledby="run-issues" class="fill-shade border-radius pad">
    <h2 id="run-issues" class="margin-none">Issues (<%= @run.issues.count %>)</h2>
    <% if @issues.any? %>
      <ul>
        <% @issues.each do |issue| %>
          <li><strong><%= issue.level %></strong><% if issue.slack_ref.present? %> <code><%= issue.slack_ref %></code><% end %> — <%= issue.message %></li>
        <% end %>
      </ul>
      <% unless @page.last? %>
        <%= link_to "Older issues", account_slack_import_run_path(@run, page: @page.next_param), class: "btn" %>
      <% end %>
    <% else %>
      <p>No issues recorded.</p>
    <% end %>
  </section>
</div>
