<% @page_title = "Import runs" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to account_slack_import_path %>
  </div>
<% end %>

<div class="panel panel--wide flex flex-column gap slack-import">
  <h1 class="margin-none">Import runs</h1>

  <% if @runs.any? %>
    <table>
      <thead>
        <tr>
          <th scope="col">Run</th>
          <th scope="col">Kind</th>
          <th scope="col">Mode</th>
          <th scope="col">Status</th>
          <th scope="col">Started by</th>
          <th scope="col">When</th>
        </tr>
      </thead>
      <tbody>
        <% @runs.each do |run| %>
          <tr>
            <td><%= link_to "##{run.id}", account_slack_import_run_path(run) %></td>
            <td><%= run.kind %></td>
            <td><%= run.mode %></td>
            <td><%= run.status %></td>
            <td><%= run.user.name %></td>
            <td><%= run.created_at %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No runs yet. <%= link_to "Start a dry run", account_slack_import_path %>.</p>
  <% end %>
</div>
