<li class="flex align-center gap margin-none <%= "banned" if user.banned? %>">
  <figure class="avatar flex-item-no-shrink" style="--avatar-size: 3.75ch;">
    <%= avatar_tag user, loading: :lazy %>
  </figure>

  <div class="min-width">
    <div class="overflow-ellipsis fill-shade"><strong><%= user.name %></strong></div>
  </div>

  <hr class="separator" aria-hidden="true">

  <% if Current.user.can_administer? && user.active? %>
    <% unless user.bot? %>
      <% if user != Current.user && user.two_factor_enabled? %>
        <%= button_to account_user_two_factor_reset_path(user), method: :post, class: "btn txt-small flex-item-no-shrink",
              title: "Reset two-step sign-in",
              data: { turbo_confirm: "Reset two-step sign-in for #{user.name}? They will sign out everywhere and set it up again at next sign-in." } do %>
          <%= image_tag "key.svg", size: 20, aria: { hidden: "true" } %>
          <span class="for-screen-reader">Reset two-step sign-in for <%= user.name %></span>
        <% end %>
      <% end %>
      <%= form_with model: user, url: account_user_path(user), data: { controller: "form" }, method: :patch do | form | %>
        <label class="btn txt-small flex-item-no-shrink" for="<%= dom_id(user, :role) %>">
          <span class="for-screen-reader">Role: <%= user.administrator? ? "Administrator" : "Member" %></span>
          <%= image_tag "crown.svg", size: 20, aria: { hidden: "true" } %>
          <%= form.check_box :role, { data: { action: "form#submit" }, hidden: true, id: dom_id(user, :role), disabled: user == Current.user }, "administrator", "member" %>
        </label>
      <% end %>

      <% if user.google_identity %>
        <%= button_to account_user_google_link_path(user), method: :delete, class: "btn txt-small flex-item-no-shrink",
              title: "Unlink Google sign-in (#{user.google_identity.email})",
              data: { turbo_confirm: "Unlink Google sign-in from #{user.name}? That Google account will no longer sign in as them." } do %>
          <%= image_tag "link.svg", size: 20, aria: { hidden: "true" } %>
          <span class="for-screen-reader">Unlink Google sign-in from <%= user.name %></span>
        <% end %>
      <% elsif (user.email_self_changed_at.present? || !user.google_email_link_allowed?) && user.email_address.present? %>
        <%= button_to account_user_google_link_path(user), method: :post, class: "btn txt-small flex-item-no-shrink btn--reversed",
              title: "Allow Google sign-in to link #{user.email_address}",
              data: { turbo_confirm: "#{user.name} chose the email #{user.email_address} themselves. Allow the Google account with that address to sign in as them?" } do %>
          <%= image_tag "link.svg", size: 20, aria: { hidden: "true" } %>
          <span class="for-screen-reader">Allow Google sign-in for <%= user.name %></span>
        <% end %>
      <% end %>
    <% end %>

    <% unless user == Current.user %>
      <%= button_to account_user_path(user), method: :delete, class: "btn txt-small flex-item-no-shrink btn--negative", data: {
            turbo_confirm: "Are you sure you want to permanently remove this person from the account? This can’t be undone."} do %>
        <%= image_tag "minus.svg", size: 20, aria: { hidden: "true" } %>
        <span class="for-screen-reader">Delete <%= user.name %></span>
      <% end %>
    <% end %>
  <% end %>
  <% if user == Current.user %>
    <%= link_to user_profile_path, class: "btn txt-small flex-item-no-shrink", target: "_top" do %>
      <%= image_tag "pencil.svg", size: 20, aria: { hidden: "true" } %>
      <span class="for-screen-reader">My settings</span>
    <% end %>
  <% end %>
</li>
