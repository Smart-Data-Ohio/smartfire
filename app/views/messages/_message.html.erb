<%# Be sure to check/update messages/_template.html.erb when changing this file %>

<%= message_tag message do %>
  <h2 class="message__day-separator"><%= local_datetime_tag message.created_at, style: :date %></h2>

  <% if message.system_note? %>
    <%= render "messages/system_note", message: message %>
  <% else %>
    <figure class="avatar message__avatar">
      <%= avatar_tag message.creator %>
    </figure>

    <turbo-frame id="<%= dom_id(message, :edit) %>">
      <div class="message__body">
        <div class="message__body-content">
          <%= render "messages/toolbar" %>
          <%= render "messages/pin_badge", message: message %>
          <%= render "messages/meta", message: message, show_room_icon: local_assigns[:show_room_icon] %>
          <%= render "messages/context", message: message %>
          <%= render "messages/presentation", message: message %>
          <%= render "messages/drive_attachments", message: message %>
          <%= render "github/pull_requests/cards", message: message %>
          <%= render "twitter/posts/cards", message: message %>
          <%= render "rooms/events/cards", message: message %>
          <%= render "fizzy/cards/cards", message: message %>
          <%= render "messages/boosts/boosts", message: message %>
        </div>
      </div>
    </turbo-frame>
  <% end %>
<% end %>
