<%# The shared message action menu, rendered once per page from the layout. %>
<%# A message-list controller opens it for one message at a time through the %>
<%# message-actions:open window event; the quick-reaction forms get their %>
<%# action and Turbo frame from the message element when it opens. %>

<div class="message__actions"
     data-controller="message-actions">
  <div id="message-actions-menu"
       class="message__actions-menu border shadow"
       popover="manual"
       role="menu"
       aria-label="Message actions"
       hidden
       data-message-actions-target="menu">
    <div class="message__quick-reactions" role="group" aria-label="Reactions">
      <% EmojiHelper::REACTIONS.each do |character, title| %>
        <%= form_with url: "#", method: :post, class: "message__reaction-form",
              data: { action: "submit->message-actions#close" } do %>
          <%= hidden_field_tag "boost[content]", character %>
          <button type="submit" title="<%= title %>" class="btn message__quick-reaction" role="menuitem"
                  data-reaction="<%= character %>" data-message-actions-target="item">
            <span aria-hidden="true"><%= character %></span>
            <span class="for-screen-reader"><%= title %></span>
          </button>
        <% end %>
      <% end %>
    </div>

    <div class="message__actions-grid border-top margin-block-start-half pad-block-start-half">
      <%= tag.button type: "button", class: "btn message__menu-action", role: "menuitem",
            data: { action: "message-actions#reply", message_actions_target: "item" } do %>
        <%= image_tag "reply.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span>Reply</span>
      <% end %>

      <%= tag.button type: "button", class: "btn message__menu-action", role: "menuitem",
            data: { action: "message-actions#copyText", message_actions_target: "item" } do %>
        <%= image_tag "copy-paste.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span>Copy text</span>
      <% end %>

      <%= tag.button type: "button", class: "btn message__menu-action", role: "menuitem",
            title: "Copy link", aria: { label: "Copy link" },
            data: { action: "message-actions#copyLink", message_actions_target: "item" } do %>
        <%= image_tag "link.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span>Copy message link</span>
      <% end %>

      <%= tag.button type: "button", class: "btn message__menu-action", role: "menuitem",
            data: { action: "message-actions#forward", message_actions_target: "item" } do %>
        <%= image_tag "share.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span>Forward</span>
      <% end %>

      <%= tag.button type: "button", class: "btn message__menu-action", role: "menuitem",
            data: { action: "message-actions#thread", message_actions_target: "item" } do %>
        <%= image_tag "messages-outlined.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span data-message-actions-target="threadLabel">Create thread</span>
      <% end %>

      <%= tag.button type: "button", class: "btn message__menu-action", role: "menuitem",
            data: { action: "message-actions#pin", message_actions_target: "item" } do %>
        <%= image_tag "pin.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span data-message-actions-target="pinLabel">Pin message</span>
      <% end %>

      <%= tag.button type: "button", class: "btn message__menu-action", role: "menuitem",
            data: { action: "message-actions#save", message_actions_target: "item" } do %>
        <%= image_tag "bookmark.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span data-message-actions-target="saveLabel">Save for later</span>
      <% end %>

      <%= tag.a class: "btn message__menu-action hide-in-ios-pwa", role: "menuitem", hidden: true,
            data: { message_actions_target: "item downloadLink" } do %>
        <%= image_tag "download.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span>Download attachment</span>
      <% end %>

      <%= tag.button type: "button", class: "btn message__menu-action message__edit-action", role: "menuitem", hidden: true,
            data: { action: "message-actions#edit", message_actions_target: "item" } do %>
        <%= image_tag "pencil.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span>Edit message</span>
      <% end %>

      <%= tag.button type: "button", class: "btn message__menu-action message__delete-action", role: "menuitem", hidden: true,
            data: { action: "message-actions#delete", message_actions_target: "item" } do %>
        <%= image_tag "trash.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span>Delete message</span>
      <% end %>

      <%= tag.button type: "button", class: "btn message__menu-action message__remove-embeds-action", role: "menuitem", hidden: true,
            data: { action: "message-actions#removeEmbeds", message_actions_target: "item" } do %>
        <%= image_tag "link.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <span>Remove embeds</span>
      <% end %>
    </div>

    <span class="for-screen-reader" role="status" aria-live="polite" data-message-actions-target="status"></span>
  </div>

  <dialog class="message-save-dialog" aria-labelledby="message-save-title"
          data-message-actions-target="saveDialog">
    <form class="message-save-dialog__form" data-action="submit->message-actions#submitSave">
      <header class="message-save-dialog__header">
        <div>
          <span class="message-save-dialog__eyebrow">Save for later</span>
          <h2 id="message-save-title">Remind me</h2>
        </div>
        <button type="button" class="btn btn--borderless message-save-dialog__close"
                aria-label="Close save dialog" data-action="message-actions#closeSave">×</button>
      </header>

      <p class="message-save-dialog__preview overflow-ellipsis" data-message-actions-target="savePreview"></p>

      <fieldset class="message-save-dialog__options" data-action="change->message-actions#revealSaveCustom">
        <legend>Optional reminder</legend>
        <label class="message-save-dialog__option">
          <%= radio_button_tag "reminder", "none", true, data: { message_actions_target: "saveOption" } %>
          <span>No reminder</span>
        </label>
        <label class="message-save-dialog__option">
          <%= radio_button_tag "reminder", "minutes_20", false, data: { message_actions_target: "saveOption" } %>
          <span>In 20 minutes</span>
        </label>
        <label class="message-save-dialog__option">
          <%= radio_button_tag "reminder", "hour_1", false, data: { message_actions_target: "saveOption" } %>
          <span>In 1 hour</span>
        </label>
        <label class="message-save-dialog__option">
          <%= radio_button_tag "reminder", "hours_3", false, data: { message_actions_target: "saveOption" } %>
          <span>In 3 hours</span>
        </label>
        <label class="message-save-dialog__option">
          <%= radio_button_tag "reminder", "tomorrow_9am", false, data: { message_actions_target: "saveOption" } %>
          <span>Tomorrow at 9am (your time)</span>
        </label>
        <label class="message-save-dialog__option">
          <%= radio_button_tag "reminder", "custom", false, data: { message_actions_target: "saveOption" } %>
          <span>Custom time</span>
        </label>
        <label class="message-save-dialog__custom" data-message-actions-target="saveCustomWrap" hidden>
          <span>Reminder time</span>
          <%= datetime_local_field_tag "reminder_custom_at", nil, data: { message_actions_target: "saveCustom" } %>
        </label>
      </fieldset>

      <p class="message-save-dialog__status" role="status" aria-live="polite" data-message-actions-target="saveStatus"></p>

      <footer class="message-save-dialog__footer">
        <button type="button" class="btn" data-action="message-actions#closeSave">Cancel</button>
        <button type="submit" class="btn btn--reversed" data-message-actions-target="saveSubmit">Save</button>
      </footer>
    </form>
  </dialog>

  <dialog class="message-forward-dialog" aria-labelledby="message-forward-title"
          data-message-actions-target="forwardDialog">
    <form class="message-forward-dialog__form" data-action="submit->message-actions#submitForward">
      <header class="message-forward-dialog__header">
        <div>
          <span class="message-forward-dialog__eyebrow">Forward message</span>
          <h2 id="message-forward-title">Choose destinations</h2>
        </div>
        <button type="button" class="btn btn--borderless message-forward-dialog__close"
                aria-label="Close forward dialog" data-action="message-actions#closeForward">×</button>
      </header>

      <p class="message-forward-dialog__preview overflow-ellipsis" data-message-actions-target="forwardPreview"></p>

      <label class="message-forward-dialog__note">
        <span>Add a note <small>(optional)</small></span>
        <textarea rows="2" maxlength="1000" placeholder="Add context for the recipients"
                  data-message-actions-target="forwardNote"></textarea>
      </label>

      <fieldset class="message-forward-dialog__destinations">
        <legend>Send to up to 5 channels or direct messages</legend>
        <div class="message-forward-dialog__destination-list" data-message-actions-target="forwardDestinations"></div>
      </fieldset>

      <p class="message-forward-dialog__status" role="status" aria-live="polite" data-message-actions-target="forwardStatus"></p>

      <footer class="message-forward-dialog__footer">
        <button type="button" class="btn" data-action="message-actions#closeForward">Cancel</button>
        <button type="submit" class="btn btn--reversed" data-message-actions-target="forwardSubmit">Forward</button>
      </footer>
    </form>
  </dialog>
</div>
