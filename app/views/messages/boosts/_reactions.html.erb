<% boosts = message.ordered_boosts %>
<% reaction_boosts, legacy_boosts = boosts.partition { |boost| Boost.reaction?(boost.content) } %>
<% grouped_reactions = reaction_boosts.group_by(&:content) %>

<div id="<%= dom_id(message, :boosts) %>" class="flex-inline flex-wrap gap">
  <% if grouped_reactions.any? %>
    <div class="boosts__reactions flex-inline flex-wrap gap" role="group" aria-label="Message reactions">
      <% grouped_reactions.each_with_index do |(content, group), index| %>
        <%= render "messages/boosts/reaction", message:, content:, boosts: group, index: %>
      <% end %>
    </div>
  <% end %>

  <% if legacy_boosts.any? %>
    <div class="boosts__legacy flex-inline flex-wrap gap">
      <%= render partial: "messages/boosts/boost", collection: legacy_boosts, as: :boost %>
    </div>
  <% end %>
</div>
