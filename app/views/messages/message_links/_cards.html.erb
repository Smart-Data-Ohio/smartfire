<%# Always rendered, even with no quotes: edits broadcast-replace this
    container, so a permalink added by an edit needs the target to exist
    and a removed permalink needs its cards cleared. The ERB tags hug the
    div so the empty container has no text nodes and the :empty rule
    hides it. %>
<% references = message_quote_references(message) %><div id="<%= dom_id(message, :message_link_cards) %>" class="message-link-cards"><% references.each do |reference| %>
  <% source = reference.referenced_message %>
  <% if source.room_id == message.room_id %>
    <%= render "messages/message_links/card", source: source %>
  <% else %>
    <%= turbo_frame_tag message_link_frame_id(reference),
          src: room_message_link_path(message.room_id, reference),
          loading: "lazy", class: "message-link-frame" %>
  <% end %>
<% end %></div>
