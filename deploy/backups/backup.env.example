# Smartfire nightly backup configuration. Installed at
# /etc/campfire-backups/backup.env by install-backup.sh (mode 0600, never
# overwritten once it exists). See docs/backups.md for the full runbook.
#
# The bucket lives in the SEPARATE backup GCP project. The VM authenticates
# with the backup-writer service account attached to the instance; no keys
# are stored here.

# Bare bucket name, without any gs:// prefix.
BACKUP_BUCKET=REPLACE-backup-bucket

# Client-side encryption: age (recommended) or gpg. The private key must
# NEVER be on this VM: only the public recipient goes here.
BACKUP_ENCRYPTION=age
BACKUP_AGE_RECIPIENT=REPLACE-age1-public-recipient
# BACKUP_GPG_RECIPIENT=backups@example.com
# BACKUP_GPG_HOME=/etc/campfire-backups/gnupg

# Everything below is optional. BACKUP_VOLUME_DIR is for testing only: when
# set, the database is snapshotted with the host sqlite3 CLI instead of
# through the running app container.
# BACKUP_DB_REL=db/production.sqlite3
# BACKUP_FILES_REL=files
# BACKUP_APP_HOST=chat.smartdata.net
# BACKUP_STATE_ROOT=/var/backups
# BACKUP_UPLOAD_BIN=gcloud
