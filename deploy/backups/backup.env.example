# Smartfire backup configuration for MANUAL runs on the VM.
# See docs/backups.md for the full runbook.
#
# The nightly backup needs none of this: the GitHub Actions workflow copies
# campfire-backup.sh to the VM on every run and passes the public recipient
# as an environment variable. Nothing is installed on the VM.
#
# For a one-off backup by hand (for example, preserving the live state before
# a restore), copy this file aside on the VM, fill in the recipient, and run:
#
#   sudo bash -c 'set -a; source ./backup.env; bash deploy/backups/campfire-backup.sh --output-dir /var/backups/manual'
#
# from a checkout of this repository. The private key must NEVER be on the VM:
# only the public recipient goes here.

# Client-side encryption: age (recommended) or gpg.
BACKUP_ENCRYPTION=age
BACKUP_AGE_RECIPIENT=REPLACE-age1-public-recipient
# BACKUP_GPG_RECIPIENT=backups@example.com
# BACKUP_GPG_HOME=/root/backup-gnupg

# Everything below is optional. BACKUP_VOLUME_DIR is for testing only: when
# set, the database is snapshotted with the host sqlite3 CLI instead of
# through the running app container.
# BACKUP_DB_REL=db/production.sqlite3
# BACKUP_FILES_REL=files
# BACKUP_APP_HOST=chat.smartdata.net
# BACKUP_STATE_ROOT=/var/backups
