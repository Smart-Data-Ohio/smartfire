# The media image builds from the repository root (compose.yaml's context: ../..) but needs only
# the gateway and the runtime scripts it COPYs. Everything else stays out of the context.
*
!huddle-gateway/package.json
!huddle-gateway/package-lock.json
!huddle-gateway/gateway.mjs
!huddle-gateway/server.mjs
!deploy/huddles/runtime/start.mjs
!deploy/huddles/runtime/supervisor.mjs
