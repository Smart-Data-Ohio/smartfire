# Rust build output, restored seeds and local tooling state are ignored in rust/.gitignore.

# Scratch space the Rust CI and test tools create beside rust/ (rust/ci/with-release-inputs.sh,
# the messaging browser host, ...).
/.scratch/

# Local server output when the app runs from the repository root (cargo run --manifest-path
# rust/Cargo.toml ...): its storage/ directory and any SQLite files beside it.
/storage/
/log/
/tmp/
/*.sqlite3
/*.sqlite3-*

# Production environment files.
/.env

# Agent worktrees and local tooling state.
/.claude/

# Python bytecode from the ops and deploy tests.
__pycache__/
