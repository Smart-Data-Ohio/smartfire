target/
/.cargo-home

# Agent worktrees and local tooling state.
/.claude/

# Scratch space the CI and test tools create at the repository root (ci/with-release-inputs.sh,
# the messaging browser host, ...).
/.scratch/

/parity/node_modules
/parity/.seed
/parity/.ci

# Local LiveKit and the bundle builders write into web/.
/web/public/assets
/web/script/*/node_modules/
/web/.bundle

# The huddle gateway's npm install and its project-local LiveKit server.
/huddle-gateway/node_modules
/huddle-gateway/.bundle

# Local server output: `cargo run -p campfire -- server` keeps its database, uploads and backups in
# storage/ under the working directory unless CAMPFIRE_STORAGE_PATH says otherwise.
/storage/
/log/
/tmp/
*.sqlite3
*.sqlite3-*
# The committed test seeds are SQLite databases too.
!/parity/seeds/frozen/*/db/*.sqlite3

# Production environment files.
/.env

# Python bytecode from the ops, CI and deploy tests.
__pycache__/
