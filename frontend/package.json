{
  "name": "smartfire-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen": "rm -f src/gen/*.ts && cargo test -p campfire_api_types export_bindings -j 4",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/oxlint-anti-slop",
    "lint": "biome check",
    "lint:anti-slop": "oxlint",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "motion:scan": "npx -y transitions-agent@0.11.1 scan",
    "check": "pnpm lint && pnpm lint:anti-slop && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "border-beam": "1.4.1",
    "bot-avatars": "0.2.2",
    "effect": "4.0.1",
    "metal-fx": "2.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "thinking-orbs": "0.3.2",
    "virtua": "0.53.1",
    "voice-glow": "0.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@biomejs/biome": "2.5.15",
    "@effect/vitest": "4.0.1",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.2",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  }
}
