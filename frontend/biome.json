{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!tools/oxlint-anti-slop", "!src/gen", "!e2e/fixtures/auth-pages"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/api/**", "!src/sync/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "effect": "Effect stays in src/api and src/sync. Call the plain async functions in src/sync/runtime.ts (actions) instead."
                },
                "patterns": [
                  {
                    "group": ["effect/**", "@effect/**"],
                    "message": "Effect stays in src/api and src/sync. Call the plain async functions in src/sync/runtime.ts (actions) instead."
                  },
                  {
                    "group": ["**/api/**", "!**/api/testing.ts", "!**/api/schema/appearance.ts"],
                    "message": "React code doesn't call endpoints. Add a plain async function to actions in src/sync/runtime.ts (or a facade module in src/sync) and call that."
                  },
                  {
                    "group": [
                      "**/sync/**",
                      "!**/sync/runtime.ts",
                      "!**/sync/composer-actions.ts",
                      "!**/sync/directs.ts",
                      "!**/sync/huddles.ts",
                      "!**/sync/panes.ts",
                      "!**/sync/settings.ts",
                      "!**/sync/admin.ts",
                      "!**/sync/auth.ts",
                      "!**/sync/run.ts"
                    ],
                    "message": "src/sync's Effect programs stay behind the plain async facades: actions in src/sync/runtime.ts, composer-actions.ts, directs.ts, huddles.ts, panes.ts, settings.ts, admin.ts or auth.ts."
                  },
                  {
                    "group": ["**/sync/runtime.ts"],
                    "importNamePattern": "(runAction|runtime)",
                    "message": "Running Effect programs is src/sync's job. Call (or add) a plain async function on actions instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/motion/recipes/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
