#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$root"
source "${WS13_LIVEKIT_ENV:-$PWD/huddle-gateway/.bundle/livekit/env}"
huddle-gateway/livekit-local status
hash=$(cat parity/Dockerfile.playwright parity/package-lock.json | sha256sum | cut -c1-12)
image="ws13-parity-playwright:$hash"
if ! docker image inspect "$image" >/dev/null 2>&1; then
  docker build -q --label parity.owner=ws13 -f parity/Dockerfile.playwright -t "$image" parity
fi
npm ci --ignore-scripts --no-audit --no-fund --prefix huddle-gateway
# Exercise the asynchronous sampling contract before any media acceptance.
docker run --rm --init --name ws13-polling-regression --network none --ipc host --cpus 2 --user "$(id -u):$(id -g)" --volume "$root/parity:$root/parity:ro" --volume "$PWD/.scratch:$PWD/.scratch" --env TMPDIR="$root/.scratch" --workdir "$root/parity" "$image" node --test --test-concurrency=8 system/ws13-browser-poll.test.mjs system/ws13-media-network.test.mjs
WS13_PLAYWRIGHT_IMAGE="$image" CI=1 TMPDIR="$root/.scratch" CABLE_TEST_PORT_RANGE=52300-52349 MAIL_TEST_PORT_RANGE=52350-52399 CARGO_BUILD_JOBS=2 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 CARGO_INCREMENTAL=0 parity/system/stable-cargo test --locked -p campfire livekit_stage_system_cases_in_real_browser -- --ignored --nocapture --test-threads=8
