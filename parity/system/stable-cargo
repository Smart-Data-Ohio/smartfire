#!/usr/bin/env bash
# Cargo on the production toolchain and LLVM, as the correctness suites build (ci/exec.sh), for
# the browser scripts beside this one: RUSTUP_TOOLCHAIN overrides rust-toolchain.toml's nightly,
# and running from / keeps .cargo/config.toml's Cranelift settings out (Cargo reads config from
# the working directory's ancestors and CARGO_HOME, never from the manifest's directory). Paths
# in the arguments must therefore be absolute. Usage: stable-cargo SUBCOMMAND [ARGS...]
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
stable=$(sed -nE 's/^ARG RUST_VERSION=([0-9]+\.[0-9]+\.[0-9]+)$/\1/p' "$root/Dockerfile")
[[ -n "$stable" ]] || { echo "RUST_VERSION not found in $root/Dockerfile" >&2; exit 1; }
subcommand=${1:?Usage: stable-cargo SUBCOMMAND [ARGS...]}
shift
cd /
RUSTUP_TOOLCHAIN="$stable" exec cargo "$subcommand" --manifest-path "$root/Cargo.toml" "$@"
