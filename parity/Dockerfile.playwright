# The one image every browser suite runs Playwright in (ci/correctness.sh, parity/system,
# reference-tools). Pinned by digest: browsers, fonts, fontconfig and Node all come from these
# exact bytes, so a run never depends on the host. No GPU: Chromium falls back to SwiftShader.
FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27

ENV TZ=UTC \
    LANG=C.UTF-8 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# The locked modules live at /node_modules: Node's resolution walks up from the mounted checkout
# to /, and the runners hide the host's parity/node_modules with a tmpfs.
COPY package.json package-lock.json /opt/parity/
RUN cd /opt/parity && npm ci --omit=dev --no-audit --no-fund && mv node_modules /node_modules
